---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import ArticleMeta from "@/components/ArticleMeta.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import PracticeMode from "@/components/PracticeMode.astro";
import ArticleActions from "@/components/ArticleActions.astro";
import LanguageToggle from "@/components/LanguageToggle.astro";
import type { ArticleTranslation } from "@/lib/translations";
import { withBase } from "@/lib/url";
import { canonicalPageURL } from "@/lib/canonical";
import { articleLanguagePath, articleRouteLanguage, type ArticleLanguage } from "@/lib/articleLanguages";

interface RelatedLink {
  title: string;
  href: string;
  kicker?: string;
}

interface PracticeQuestion {
  question: string;
  hint: string;
  answer: string;
  topic?: string;
}

interface SocialImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  lang?: string;
  breadcrumbParents?: { title: string; href: string }[];
  shareHashtags?: string[];
  title: string;
  description: string;
  kicker?: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  readingMinutes?: number;
  headings: MarkdownHeading[];
  prev?: RelatedLink;
  next?: RelatedLink;
  related?: RelatedLink[];
  practice?: PracticeQuestion[];
  socialImage?: SocialImage;
  sectionHref?: string;
  practiceKey?: string;
  relatedPath?: { title: string; href: string };
  hasMath?: boolean;
  /** Second-language version; when present the article gets an EN / CN switch. */
  translation?: ArticleTranslation;
}

const {
  lang = "en",
  breadcrumbParents,
  shareHashtags,
  title,
  description,
  kicker,
  date,
  updated,
  tags = [],
  readingMinutes,
  headings,
  prev,
  next,
  related = [],
  practice = [],
  socialImage,
  sectionHref = "/",
  practiceKey,
  relatedPath,
  hasMath = false,
  translation,
} = Astro.props;
const TranslatedContent = translation?.Content;
const altLang = translation?.lang;
const base = import.meta.env.BASE_URL;
const routeLang = translation ? articleRouteLanguage(Astro.url.pathname, lang as ArticleLanguage, base) : lang;
const useTranslation = translation && routeLang === translation.lang;
const pageTitle = useTranslation ? translation.title : title;
const pageDescription = useTranslation ? translation.description : description;
const pageImage = useTranslation ? { src: `/social/auto/${translation.key}.${translation.lang}.png`, alt: translation.title, width: 1200, height: 627 } : socialImage;
const canonical = canonicalPageURL(Astro.url.pathname, Astro.site).toString();
const absoluteImageURL = (src: string) => new URL(src.startsWith("/") ? withBase(src) : src, Astro.site).toString();
const imageURL = pageImage ? absoluteImageURL(pageImage.src) : undefined;
const primaryURL = canonicalPageURL(articleLanguagePath(Astro.url.pathname, lang as ArticleLanguage, lang as ArticleLanguage, base), Astro.site).toString();
const alternateURL = translation ? canonicalPageURL(articleLanguagePath(Astro.url.pathname, translation.lang, lang as ArticleLanguage, base), Astro.site).toString() : undefined;
const languages = translation ? [
  { lang, title, description, url: primaryURL, image: socialImage ? absoluteImageURL(socialImage.src) : undefined },
  { lang: translation.lang, title: translation.title, description: translation.description, url: alternateURL!, image: absoluteImageURL(`/social/auto/${translation.key}.${translation.lang}.png`) },
] : [];
const versions = translation ? [
  { pane: "primary", lang, title, description, headings, Content: undefined },
  { pane: "alt", lang: translation.lang, title: translation.title, description: translation.description, headings: translation.headings, Content: TranslatedContent },
] : [];
// Some link previews inspect body text or the first image as a fallback.
// Put the requested language first in the source as well as on screen.
if (useTranslation) versions.reverse();
const sectionName = kicker ?? "Knowledge Base";
const parents = breadcrumbParents ?? [{ title: sectionName, href: sectionHref }];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: pageTitle,
    description: pageDescription,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    // Google expects mainEntityOfPage as a node, not a bare URL string, and
    // reports a missing `author` as a warning in the Rich Results test — which
    // is the whole point of emitting this.
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    ...(imageURL ? { image: [imageURL] } : {}),
    articleSection: sectionName,
    inLanguage: routeLang,
    keywords: tags.join(", "),
    author: { "@type": "Organization", name: "System Craft Lab", url: new URL(withBase("/"), Astro.site).toString() },
    publisher: { "@type": "Organization", name: "System Craft Lab", url: new URL(withBase("/"), Astro.site).toString() },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL(withBase("/"), Astro.site).toString() },
      ...parents.map((parent, index) => ({ "@type": "ListItem", position: index + 2, name: parent.title, item: new URL(withBase(parent.href), Astro.site).toString() })),
      { "@type": "ListItem", position: parents.length + 2, name: pageTitle, item: canonical },
    ],
  },
];
---

<BaseLayout
  lang={routeLang}
  title={pageTitle}
  description={pageDescription}
  image={pageImage?.src}
  imageAlt={pageImage?.alt}
  imageWidth={pageImage?.width}
  imageHeight={pageImage?.height}
  initialLangView={useTranslation ? "alt" : undefined}
  languageAlternates={languages.map(item => ({ lang: item.lang, href: item.url }))}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  articleSection={sectionName}
  tags={tags}
  structuredData={structuredData}
  hasMath={hasMath || translation?.hasMath === true}
>
  <article class="article-page">
    {translation && (
      <script is:inline define:vars={{ primaryLang: lang, altLang, routeLang }}>
        // Runs before the article paints so a remembered or linked language
        // never flashes the other version first. LanguageToggle wires clicks.
        (function () {
          var wanted = null;
          try {
            var query = (new URLSearchParams(location.search).get("lang") || "").toLowerCase();
            if (query === "en") wanted = "en";
            else if (query === "zh" || query === "cn" || query === "zh-cn") wanted = "zh-CN";
          } catch (e) {}
          if (!wanted && routeLang !== primaryLang) wanted = routeLang;
          if (!wanted) { try { wanted = localStorage.getItem("article-lang"); } catch (e) {} }
          var root = document.documentElement;
          root.dataset.langReady = "true";
          if (wanted === altLang && wanted !== primaryLang) {
            root.dataset.langView = "alt";
            root.lang = altLang;
          } else {
            delete root.dataset.langView;
            root.lang = primaryLang;
          }
        })();
      </script>
    )}
    {translation && <div hidden data-article-langs data-primary-lang={lang} data-alt-lang={translation.lang} data-primary-title={title} data-alt-title={translation.title} data-language-options={JSON.stringify(languages)}></div>}
    <header class="article-hero">
      <div class="wrap article-header">
        <a class="back-link" href={withBase("/")}>&larr; KNOWLEDGE BASE</a>
        {breadcrumbParents && <nav class="article-breadcrumbs" aria-label="Breadcrumb">
          {breadcrumbParents.map((parent, index) => <span class="breadcrumb-item">
            {index > 0 && <span aria-hidden="true">/</span>}
            <a href={withBase(parent.href)}>{parent.title}</a>
          </span>)}
        </nav>}
        {kicker && <p class="eyebrow">MODULE / {kicker}</p>}
        {translation ? (
          versions.map(version => <div data-lang-pane={version.pane} lang={version.lang}>
            <h1>{version.title}</h1>
            <p class="article-description">{version.description}</p>
          </div>)
        ) : (
          <>
            <h1>{title}</h1>
            <p class="article-description">{description}</p>
          </>
        )}
        <ArticleMeta date={date} updated={updated} tags={tags} readingMinutes={readingMinutes} />
        {translation && <LanguageToggle placement="top" />}
      </div>
    </header>

    {practice.length > 0 && practiceKey && <PracticeMode questions={practice} storageKey={practiceKey} />}

    <div class="wrap article-body">
      <aside class="article-toc">
        <div class="toc-sticky">
          {translation ? (
            versions.map(version => <div data-lang-pane={version.pane} lang={version.lang}><TableOfContents headings={version.headings} /></div>)
          ) : <TableOfContents headings={headings} />}
        </div>
      </aside>
      <div class="prose">
        {TranslatedContent ? (
          versions.map(version => {
            const Content = version.Content;
            return <div data-lang-pane={version.pane} lang={version.lang}>{Content ? <Content /> : <slot />}</div>;
          })
        ) : <slot />}
      </div>
    </div>

    <footer class="wrap article-footer">
        {translation && <LanguageToggle placement="bottom" />}
        <ArticleActions title={pageTitle} description={pageDescription} lang={routeLang} canonical={canonical} relatedPath={relatedPath} shareHashtags={shareHashtags} />
        {(prev || next) && (
          <nav class="prev-next" aria-label="Article navigation">
            <a class:list={["prev-next-link", { disabled: !prev }]} href={prev ? withBase(prev.href) : undefined}>
              {prev && (
                <>
                  <span class="muted">&larr; Previous</span>
                  <span>{prev.title}</span>
                </>
              )}
            </a>
            <a class:list={["prev-next-link", "next", { disabled: !next }]} href={next ? withBase(next.href) : undefined}>
              {next && (
                <>
                  <span class="muted">Next &rarr;</span>
                  <span>{next.title}</span>
                </>
              )}
            </a>
          </nav>
        )}
        {related.length > 0 && (
          <div class="related">
            <p class="eyebrow">Related</p>
            <ul>
              {related.map((item) => (
                <li>
                  <a href={withBase(item.href)}>{item.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </footer>
  </article>
</BaseLayout>

<style>
  :global(html:not([data-lang-view="alt"]) [data-lang-pane="alt"]),
  :global(html[data-lang-view="alt"] [data-lang-pane="primary"]) { display: none; }
  /* Without JavaScript the switch could not work, so it is not shown. */
  :global(html:not([data-lang-ready]) [data-lang-toggle]) { display: none; }
  .article-breadcrumbs { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 18px; font: .72rem var(--font-mono); }
  .breadcrumb-item { display: inline-flex; gap: 12px; }
  .breadcrumb-item > span { color: var(--color-text-muted); }
  .article-header {
    max-width: 980px;
    margin: 0 auto;
    padding-block: 46px 42px;
  }
  .article-hero {
    position: relative;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-raised) 88%, transparent);
    overflow: hidden;
  }
  .article-hero::after {
    position: absolute;
    right: max(24px, calc((100vw - var(--wide-width)) / 2));
    bottom: -50px;
    width: 180px;
    height: 180px;
    border: 1px solid var(--color-border);
    content: "";
    transform: rotate(45deg);
  }
  .back-link {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-bottom: 34px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
  }
  .article-header h1 {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 10px 0 14px;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }
  .article-description {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.08rem;
  }

  .article-body {
    display: grid;
    grid-template-columns: 220px minmax(0, var(--content-width)) 100px;
    gap: 52px;
    justify-content: center;
    margin-top: 44px;
  }

  .article-toc {
    display: none;
  }

  .toc-sticky {
    position: sticky;
    top: 96px;
    padding: 16px 0 16px 16px;
    border-left: 1px solid var(--color-border);
  }

  .article-footer {
    max-width: var(--content-width);
    margin: 64px auto 0;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }

  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .prev-next-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    background: var(--color-bg-raised);
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 700;
  }
  .prev-next-link:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .prev-next-link.next {
    text-align: right;
    align-items: flex-end;
  }
  .prev-next-link.disabled {
    visibility: hidden;
  }

  .related {
    margin-top: 24px;
  }
  .related ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @media (min-width: 900px) {
    .article-toc {
      display: block;
    }
  }

  @media (max-width: 1120px) {
    .article-body { grid-template-columns: 200px minmax(0, var(--content-width)); }
  }

  @media (max-width: 640px) {
    .article-header { padding-block: 34px; }
    .article-hero::after { display: none; }
    .article-body { display: block; margin-top: 30px; }
    .prev-next {
      grid-template-columns: 1fr;
    }
    .prev-next-link.next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>

<script>
  // Add a copy button to every fenced code block rendered by Shiki. This is
  // pure progressive enhancement: with JS disabled the code is still readable.
  // Mermaid diagrams arrive as inline SVG, rendered at build time by
  // src/lib/rehypeMermaid.mjs.
  function setupCopyButtons() {
    document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
      if (pre.querySelector(".copy-button")) return;
      const button = document.createElement("button");
      button.type = "button";
      button.className = "copy-button";
      button.textContent = "Copy";
      button.addEventListener("click", async () => {
        const code = pre.querySelector("code")?.innerText ?? "";
        try {
          await navigator.clipboard.writeText(code);
          button.dataset.copied = "true";
          button.textContent = "Copied";
          setTimeout(() => {
            button.dataset.copied = "false";
            button.textContent = "Copy";
          }, 1500);
        } catch {
          /* clipboard API unavailable; button is a no-op */
        }
      });
      pre.appendChild(button);
    });
  }

  setupCopyButtons();
</script>
