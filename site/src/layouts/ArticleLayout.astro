---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import ArticleMeta from "@/components/ArticleMeta.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import PracticeMode from "@/components/PracticeMode.astro";
import ArticleActions from "@/components/ArticleActions.astro";
import { withBase } from "@/lib/url";

interface RelatedLink {
  title: string;
  href: string;
  kicker?: string;
}

interface PracticeQuestion {
  question: string;
  hint: string;
  answer: string;
  topic?: string;
}

interface SocialImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  title: string;
  description: string;
  kicker?: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  readingMinutes?: number;
  headings: MarkdownHeading[];
  prev?: RelatedLink;
  next?: RelatedLink;
  related?: RelatedLink[];
  practice?: PracticeQuestion[];
  socialImage?: SocialImage;
  sectionHref?: string;
  practiceKey?: string;
  relatedPath?: { title: string; href: string };
}

const {
  title,
  description,
  kicker,
  date,
  updated,
  tags = [],
  readingMinutes,
  headings,
  prev,
  next,
  related = [],
  practice = [],
  socialImage,
  sectionHref = "/",
  practiceKey,
  relatedPath,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const imageURL = socialImage ? new URL(socialImage.src, Astro.site).toString() : undefined;
const sectionName = kicker ?? "Knowledge Base";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    // Google expects mainEntityOfPage as a node, not a bare URL string, and
    // reports a missing `author` as a warning in the Rich Results test — which
    // is the whole point of emitting this.
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    ...(imageURL ? { image: [imageURL] } : {}),
    articleSection: sectionName,
    keywords: tags.join(", "),
    author: { "@type": "Organization", name: "System Craft Lab", url: new URL(withBase("/"), Astro.site).toString() },
    publisher: { "@type": "Organization", name: "System Craft Lab", url: new URL(withBase("/"), Astro.site).toString() },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL(withBase("/"), Astro.site).toString() },
      { "@type": "ListItem", position: 2, name: sectionName, item: new URL(withBase(sectionHref), Astro.site).toString() },
      { "@type": "ListItem", position: 3, name: title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  image={socialImage?.src}
  imageAlt={socialImage?.alt}
  imageWidth={socialImage?.width}
  imageHeight={socialImage?.height}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  articleSection={sectionName}
  tags={tags}
  structuredData={structuredData}
>
  <article class="article-page">
    <header class="article-hero">
      <div class="wrap article-header">
        <a class="back-link" href={withBase("/")}>&larr; KNOWLEDGE BASE</a>
        {kicker && <p class="eyebrow">MODULE / {kicker}</p>}
        <h1>{title}</h1>
        <p class="article-description">{description}</p>
        <ArticleMeta date={date} updated={updated} tags={tags} readingMinutes={readingMinutes} />
      </div>
    </header>

    {practice.length > 0 && practiceKey && <PracticeMode questions={practice} storageKey={practiceKey} />}

    <div class="wrap article-body">
      <aside class="article-toc">
        <div class="toc-sticky">
          <TableOfContents headings={headings} />
        </div>
      </aside>
      <div class="prose">
        <slot />
      </div>
    </div>

    <footer class="wrap article-footer">
        <ArticleActions title={title} description={description} canonical={canonical} relatedPath={relatedPath} />
        {(prev || next) && (
          <nav class="prev-next" aria-label="Article navigation">
            <a class:list={["prev-next-link", { disabled: !prev }]} href={prev ? withBase(prev.href) : undefined}>
              {prev && (
                <>
                  <span class="muted">&larr; Previous</span>
                  <span>{prev.title}</span>
                </>
              )}
            </a>
            <a class:list={["prev-next-link", "next", { disabled: !next }]} href={next ? withBase(next.href) : undefined}>
              {next && (
                <>
                  <span class="muted">Next &rarr;</span>
                  <span>{next.title}</span>
                </>
              )}
            </a>
          </nav>
        )}
        {related.length > 0 && (
          <div class="related">
            <p class="eyebrow">Related</p>
            <ul>
              {related.map((item) => (
                <li>
                  <a href={withBase(item.href)}>{item.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </footer>
  </article>
</BaseLayout>

<style>
  .article-header {
    max-width: 980px;
    margin: 0 auto;
    padding-block: 46px 42px;
  }
  .article-hero {
    position: relative;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-raised) 88%, transparent);
    overflow: hidden;
  }
  .article-hero::after {
    position: absolute;
    right: max(24px, calc((100vw - var(--wide-width)) / 2));
    bottom: -50px;
    width: 180px;
    height: 180px;
    border: 1px solid var(--color-border);
    content: "";
    transform: rotate(45deg);
  }
  .back-link {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-bottom: 34px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
  }
  .article-header h1 {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 10px 0 14px;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }
  .article-description {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.08rem;
  }

  .article-body {
    display: grid;
    grid-template-columns: 220px minmax(0, var(--content-width)) 100px;
    gap: 52px;
    justify-content: center;
    margin-top: 44px;
  }

  .article-toc {
    display: none;
  }

  .toc-sticky {
    position: sticky;
    top: 96px;
    padding: 16px 0 16px 16px;
    border-left: 1px solid var(--color-border);
  }

  .article-footer {
    max-width: var(--content-width);
    margin: 64px auto 0;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }

  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .prev-next-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    background: var(--color-bg-raised);
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 700;
  }
  .prev-next-link:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .prev-next-link.next {
    text-align: right;
    align-items: flex-end;
  }
  .prev-next-link.disabled {
    visibility: hidden;
  }

  .related {
    margin-top: 24px;
  }
  .related ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @media (min-width: 900px) {
    .article-toc {
      display: block;
    }
  }

  @media (max-width: 1120px) {
    .article-body { grid-template-columns: 200px minmax(0, var(--content-width)); }
  }

  @media (max-width: 640px) {
    .article-header { padding-block: 34px; }
    .article-hero::after { display: none; }
    .article-body { display: block; margin-top: 30px; }
    .prev-next {
      grid-template-columns: 1fr;
    }
    .prev-next-link.next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>

<script>
  // Add a copy button to every fenced code block rendered by Shiki, and
  // upgrade any ```mermaid block into a rendered SVG diagram. Both are
  // pure progressive enhancement: with JS disabled the plain <pre><code>
  // block (including mermaid source) still renders and is readable.
  function setupCopyButtons() {
    document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
      if (pre.querySelector(".copy-button")) return;
      const button = document.createElement("button");
      button.type = "button";
      button.className = "copy-button";
      button.textContent = "Copy";
      button.addEventListener("click", async () => {
        const code = pre.querySelector("code")?.innerText ?? "";
        try {
          await navigator.clipboard.writeText(code);
          button.dataset.copied = "true";
          button.textContent = "Copied";
          setTimeout(() => {
            button.dataset.copied = "false";
            button.textContent = "Copy";
          }, 1500);
        } catch {
          /* clipboard API unavailable; button is a no-op */
        }
      });
      pre.appendChild(button);
    });
  }

  async function renderMermaid() {
    const blocks = document.querySelectorAll<HTMLElement>(
      '.prose pre[data-language="mermaid"] code'
    );
    if (blocks.length === 0) return;

    const { default: mermaid } = await import("mermaid");
    const isDark = document.documentElement.getAttribute("data-theme") === "dark";
    mermaid.initialize({ startOnLoad: false, theme: isDark ? "dark" : "default" });

    let index = 0;
    for (const block of Array.from(blocks)) {
      const pre = block.closest("pre");
      if (!pre) continue;
      const source = block.textContent ?? "";
      const id = `mermaid-diagram-${index++}`;
      try {
        const { svg } = await mermaid.render(id, source);
        const container = document.createElement("div");
        container.className = "mermaid-diagram";
        container.tabIndex = 0;
        container.setAttribute("role", "group");
        container.setAttribute("aria-label", "Architecture diagram, scroll horizontally to explore");
        container.innerHTML = svg;
        pre.replaceWith(container);
        const diagram = container.querySelector("svg");
        if (diagram) {
          // Mermaid's default max-width shrinks large diagrams until labels are unreadable.
          // Preserve a useful scale and let the containing panel scroll instead.
          const naturalWidth = diagram.viewBox.baseVal.width || container.clientWidth;
          diagram.style.maxWidth = "none";
          diagram.style.width = `${Math.max(container.clientWidth - 32, Math.min(1800, Math.ceil(naturalWidth * 0.75)))}px`;
          diagram.style.height = "auto";
        }
      } catch {
        // Leave the original code block in place if rendering fails.
      }
    }
  }

  setupCopyButtons();
  renderMermaid();
</script>
