---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import ArticleMeta from "@/components/ArticleMeta.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { withBase } from "@/lib/url";

interface RelatedLink {
  title: string;
  href: string;
  kicker?: string;
}

interface Props {
  title: string;
  description: string;
  kicker?: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  readingMinutes?: number;
  headings: MarkdownHeading[];
  prev?: RelatedLink;
  next?: RelatedLink;
  related?: RelatedLink[];
}

const {
  title,
  description,
  kicker,
  date,
  updated,
  tags = [],
  readingMinutes,
  headings,
  prev,
  next,
  related = [],
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
>
  <article class="wrap article-page">
    <header class="article-header">
      {kicker && <p class="eyebrow">{kicker}</p>}
      <h1>{title}</h1>
      <p class="article-description muted">{description}</p>
      <ArticleMeta date={date} updated={updated} tags={tags} readingMinutes={readingMinutes} />
    </header>

    <div class="article-body">
      <aside class="article-toc">
        <div class="toc-sticky">
          <TableOfContents headings={headings} />
        </div>
      </aside>
      <div class="prose">
        <slot />
      </div>
    </div>

    {(prev || next || related.length > 0) && (
      <footer class="article-footer">
        {(prev || next) && (
          <nav class="prev-next" aria-label="Article navigation">
            <a class:list={["prev-next-link", { disabled: !prev }]} href={prev ? withBase(prev.href) : undefined}>
              {prev && (
                <>
                  <span class="muted">&larr; Previous</span>
                  <span>{prev.title}</span>
                </>
              )}
            </a>
            <a class:list={["prev-next-link", "next", { disabled: !next }]} href={next ? withBase(next.href) : undefined}>
              {next && (
                <>
                  <span class="muted">Next &rarr;</span>
                  <span>{next.title}</span>
                </>
              )}
            </a>
          </nav>
        )}
        {related.length > 0 && (
          <div class="related">
            <p class="eyebrow">Related</p>
            <ul>
              {related.map((item) => (
                <li>
                  <a href={withBase(item.href)}>{item.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .article-header {
    max-width: var(--content-width);
    margin: 40px auto 0;
  }
  .article-header h1 {
    margin: 6px 0 4px;
    font-size: 2.1rem;
    line-height: 1.25;
  }
  .article-description {
    font-size: 1.08rem;
    margin: 0;
  }

  .article-body {
    display: grid;
    grid-template-columns: 200px minmax(0, var(--content-width));
    gap: 48px;
    justify-content: center;
    margin-top: 28px;
  }

  .article-toc {
    display: none;
  }

  .toc-sticky {
    position: sticky;
    top: 84px;
  }

  .article-footer {
    max-width: var(--content-width);
    margin: 56px auto 0;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .prev-next-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
  }
  .prev-next-link:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .prev-next-link.next {
    text-align: right;
    align-items: flex-end;
  }
  .prev-next-link.disabled {
    visibility: hidden;
  }

  .related {
    margin-top: 24px;
  }
  .related ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @media (min-width: 900px) {
    .article-toc {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .prev-next {
      grid-template-columns: 1fr;
    }
    .prev-next-link.next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>

<script>
  // Add a copy button to every fenced code block rendered by Shiki, and
  // upgrade any ```mermaid block into a rendered SVG diagram. Both are
  // pure progressive enhancement: with JS disabled the plain <pre><code>
  // block (including mermaid source) still renders and is readable.
  function setupCopyButtons() {
    document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
      if (pre.querySelector(".copy-button")) return;
      const button = document.createElement("button");
      button.type = "button";
      button.className = "copy-button";
      button.textContent = "Copy";
      button.addEventListener("click", async () => {
        const code = pre.querySelector("code")?.innerText ?? "";
        try {
          await navigator.clipboard.writeText(code);
          button.dataset.copied = "true";
          button.textContent = "Copied";
          setTimeout(() => {
            button.dataset.copied = "false";
            button.textContent = "Copy";
          }, 1500);
        } catch {
          /* clipboard API unavailable; button is a no-op */
        }
      });
      pre.appendChild(button);
    });
  }

  async function renderMermaid() {
    const blocks = document.querySelectorAll<HTMLElement>(
      '.prose pre[data-language="mermaid"] code'
    );
    if (blocks.length === 0) return;

    const { default: mermaid } = await import("mermaid");
    const isDark = document.documentElement.getAttribute("data-theme") === "dark";
    mermaid.initialize({ startOnLoad: false, theme: isDark ? "dark" : "default" });

    let index = 0;
    for (const block of Array.from(blocks)) {
      const pre = block.closest("pre");
      if (!pre) continue;
      const source = block.textContent ?? "";
      const id = `mermaid-diagram-${index++}`;
      try {
        const { svg } = await mermaid.render(id, source);
        const container = document.createElement("div");
        container.className = "mermaid-diagram";
        container.innerHTML = svg;
        pre.replaceWith(container);
      } catch {
        // Leave the original code block in place if rendering fails.
      }
    }
  }

  setupCopyButtons();
  renderMermaid();
</script>
