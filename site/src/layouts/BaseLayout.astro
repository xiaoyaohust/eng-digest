---
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import { withBase } from "@/lib/url";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description,
  image,
  type = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const pageTitle = title === "Eng Knowledge" ? title : `${title} · Eng Knowledge`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Listing and utility pages share the site's visual identity. Article pages
// intentionally omit the generic image until they have their own artwork.
const resolvedImage = image ?? (type === "website" ? withBase("/og.png") : undefined);
const ogImage = resolvedImage ? new URL(resolvedImage, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}

    <script is:inline>
      // Runs before paint to avoid a light/dark flash. Falls back to system
      // preference when nothing is stored (private browsing, cleared storage).
      (function () {
        try {
          var stored = localStorage.getItem("eng-digest-theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (e) {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navbar />
    <!--
      data-pagefind-body switches Pagefind to opt-in indexing: only content
      inside an element carrying this attribute is indexed anywhere on the
      site, so the Navbar/Footer (siblings, not descendants, of <main>)
      never show up in search results.
    -->
    <main id="main-content" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <!-- Cloudflare Web Analytics: one beacon here tracks every Astro route by path. -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token":"6c70276a0fb042b6843ef447f2419e9d"}'
    ></script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 8px 12px;
    border-radius: 6px;
    background: var(--color-accent-bright);
    color: #061511;
    font-weight: 700;
    transform: translateY(-150%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
