---
import { render } from "astro:content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { published, findRelated, allCandidates } from "@/lib/content";
import { readingTime } from "@/lib/url";

export async function getStaticPaths() {
  const entries = await published("field-notes");
  return entries.map((entry, index, all) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prevEntry: all[index + 1],
      nextEntry: all[index - 1],
    },
  }));
}

const { entry, prevEntry, nextEntry } = Astro.props;
const { Content, headings } = await render(entry);
const related = findRelated(entry.data.tags, await allCandidates(), `/field-notes/${entry.id}/`);
const socialImage = entry.data.socialImage ?? {
  src: `/social/auto/field-notes/${entry.id}.png`,
  alt: `${entry.data.title} social preview`,
  width: 1200,
  height: 627,
};
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  kicker="Engineering Field Notes"
  date={entry.data.date}
  updated={entry.data.updated}
  tags={entry.data.tags}
  readingMinutes={readingTime(entry.body ?? "")}
  headings={headings}
  prev={prevEntry && { title: prevEntry.data.title, href: `/field-notes/${prevEntry.id}/` }}
  next={nextEntry && { title: nextEntry.data.title, href: `/field-notes/${nextEntry.id}/` }}
  related={related}
  socialImage={socialImage}
  sectionHref="/field-notes/"
>
  <Content />
</ArticleLayout>
