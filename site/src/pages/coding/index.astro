---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { published } from "@/lib/content";

const articles = await published("coding");
---

<BaseLayout title="Coding" description="Algorithms, patterns, and interview problems.">
  <div class="wrap section">
    <h1>Coding</h1>
    <p class="muted section-intro">Algorithms, patterns, and interview problems.</p>
    <div class="section-status"><span>MODULE 02</span><span>{articles.length} NOTES</span><span>PATTERNS / COMPLEXITY / PRACTICE</span></div>
    <div class="card-grid">
      {articles.map((entry) => (
        <ArticleCard
          href={`/coding/${entry.id}/`}
          kicker="Coding"
          title={entry.data.title}
          description={entry.data.description}
          date={entry.data.date}
          tags={entry.data.tags}
        />
      ))}
    </div>
    {articles.length === 0 && <p class="muted">No articles yet.</p>}
  </div>
</BaseLayout>

<style>
  .section {
    padding: 56px 0 80px;
  }
  .section-intro {
    margin: 14px 0 24px;
  }
  .section-status {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-bottom: 30px;
    padding: 10px 12px;
    border-block: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
  }
</style>
