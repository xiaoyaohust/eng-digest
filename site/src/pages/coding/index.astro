---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { published } from "@/lib/content";

const articles = await published("coding");
---

<BaseLayout title="Coding" description="Algorithms, patterns, and interview problems.">
  <div class="wrap section">
    <h1>Coding</h1>
    <p class="muted section-intro">Algorithms, patterns, and interview problems.</p>
    <div class="card-grid">
      {articles.map((entry) => (
        <ArticleCard
          href={`/coding/${entry.id}/`}
          kicker="Coding"
          title={entry.data.title}
          description={entry.data.description}
          date={entry.data.date}
          tags={entry.data.tags}
        />
      ))}
    </div>
    {articles.length === 0 && <p class="muted">No articles yet.</p>}
  </div>
</BaseLayout>

<style>
  .section {
    padding: 44px 0 64px;
  }
  .section-intro {
    margin: -6px 0 28px;
  }
</style>
