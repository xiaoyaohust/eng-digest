---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { published } from "@/lib/content";

const articles = await published("interviews");
---

<BaseLayout
  title="Interview Experiences"
  description="Real interview notes, formats, and lessons learned."
>
  <div class="wrap section">
    <h1>Interview Experiences</h1>
    <p class="muted section-intro">Real interview notes, formats, and lessons learned.</p>
    <div class="section-status"><span>MODULE 03</span><span>{articles.length} FIELD NOTES</span><span>FORMAT / SIGNAL / DEBRIEF</span></div>
    <div class="card-grid">
      {articles.map((entry) => (
        <ArticleCard
          href={`/interviews/${entry.id}/`}
          kicker={entry.data.company ? `${entry.data.company} Interview` : "Interview"}
          title={entry.data.title}
          description={entry.data.description}
          date={entry.data.date}
          tags={entry.data.tags}
        />
      ))}
    </div>
    {articles.length === 0 && <p class="muted">No articles yet.</p>}
  </div>
</BaseLayout>

<style>
  .section {
    padding: 56px 0 80px;
  }
  .section-intro {
    margin: 14px 0 24px;
  }
  .section-status {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-bottom: 30px;
    padding: 10px 12px;
    border-block: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
  }
</style>
