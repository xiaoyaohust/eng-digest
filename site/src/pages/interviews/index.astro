---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { published } from "@/lib/content";

const articles = await published("interviews");
---

<BaseLayout
  title="Interview Experiences"
  description="Real interview notes, formats, and lessons learned."
>
  <div class="wrap section">
    <h1>Interview Experiences</h1>
    <p class="muted section-intro">Real interview notes, formats, and lessons learned.</p>
    <div class="card-grid">
      {articles.map((entry) => (
        <ArticleCard
          href={`/interviews/${entry.id}/`}
          kicker={entry.data.company ? `${entry.data.company} Interview` : "Interview"}
          title={entry.data.title}
          description={entry.data.description}
          date={entry.data.date}
          tags={entry.data.tags}
        />
      ))}
    </div>
    {articles.length === 0 && <p class="muted">No articles yet.</p>}
  </div>
</BaseLayout>

<style>
  .section {
    padding: 44px 0 64px;
  }
  .section-intro {
    margin: -6px 0 28px;
  }
</style>
