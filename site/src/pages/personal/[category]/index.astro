---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { published } from "@/lib/content";
import { groupByLatestArticle } from "@/lib/contentOrdering";
import { withBase } from "@/lib/url";
import { personalArticleHref, personalCategories, personalCategoryIds, personalTopicId, PERSONAL_SECTION_NAME } from "@/data/personal";

// Every column gets a page, even before its first article, so the section's
// links never 404 while articles are still being written.
export async function getStaticPaths() {
  const articles = await published("personal");
  return personalCategoryIds.map((id) => ({
    params: { category: id },
    props: { category: personalCategories[id], entries: articles.filter((entry) => entry.data.category === id) },
  }));
}
const { category, entries } = Astro.props;
const hasTopics = entries.some((entry) => entry.data.topic);
const topics = groupByLatestArticle(entries, (entry) => entry.data.topic ?? "Other articles");
---

<BaseLayout title={`${category.name} · ${PERSONAL_SECTION_NAME}`} description={category.description}>
  <section class="wrap column-page">
    <a href={withBase("/personal/")}>← {PERSONAL_SECTION_NAME}</a>
    <p class="eyebrow">{category.label}</p>
    <h1>{category.name}</h1>
    <p class="subtitle">{category.subtitle}</p>
    <p class="intro">{category.description}</p>
    {hasTopics && <nav class="personal-topic-nav" aria-label="Article chapters">
      {topics.map(([topic, articles]) => <a href={`#${personalTopicId(topic)}`}>{topic} <small>{articles.length}</small></a>)}
    </nav>}
    {hasTopics ? topics.map(([topic, articles]) => (
      <section class="personal-topic" id={personalTopicId(topic)}>
        <h2>{topic}</h2>
        <div class="card-grid">
          {articles.map((entry) => <ArticleCard href={`${personalArticleHref(entry)}?lang=en`} kicker={category.name} title={entry.data.title} description={entry.data.description} date={entry.data.date} tags={entry.data.tags} />)}
        </div>
      </section>
    )) : entries.length > 0 ? (
      <>
      <h2>Articles</h2>
      <div class="card-grid">
        {entries.map((entry) => <ArticleCard href={`${personalArticleHref(entry)}?lang=en`} kicker={category.name} title={entry.data.title} description={entry.data.description} date={entry.data.date} tags={entry.data.tags} />)}
      </div>
      </>
    ) : (
      <>
      <h2>Articles</h2>
      <p class="empty-state">The first articles in this column are on the way.</p>
      </>
    )}
  </section>
</BaseLayout>

<style>
  .column-page { padding-block: 50px 70px; }
  .eyebrow { margin-top: 36px; }
  h1 { font-size: clamp(2.4rem, 6vw, 4rem); margin-bottom: 8px; }
  .subtitle { margin-top: 0; color: var(--color-accent); }
  .intro { max-width: 720px; color: var(--color-text-muted); }
  h2 { margin-top: 44px; }
  .personal-topic-nav { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .personal-topic-nav a { max-width: 100%; padding: 9px 12px; border: 1px solid var(--color-border-strong); border-radius: 6px; font-size: .85rem; overflow-wrap: anywhere; }
  .personal-topic-nav small { margin-left: 8px; color: var(--color-text-muted); }
  .personal-topic { margin-top: 42px; scroll-margin-top: 100px; }
  .personal-topic h2 { margin: 0 0 20px; padding-bottom: 14px; border-bottom: 1px solid var(--color-border); font-size: clamp(1.2rem, 3vw, 1.6rem); line-height: 1.55; }
  .empty-state { padding: 22px; border: 1px dashed var(--color-border-strong); border-radius: 8px; color: var(--color-text-muted); font: .78rem var(--font-mono); }
</style>
