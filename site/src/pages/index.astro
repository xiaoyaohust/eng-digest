---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import DigestCard from "@/components/DigestCard.astro";
import { withBase } from "@/lib/url";
import { published, publishedDigests } from "@/lib/content";

const [systemDesign, coding, interviews, digests] = await Promise.all([
  published("system-design"),
  published("coding"),
  published("interviews"),
  publishedDigests(),
]);

type Kicker = "System Design" | "Coding" | "Interview";
interface CardEntry {
  href: string;
  kicker: Kicker;
  title: string;
  description: string;
  date: Date;
  tags: string[];
  featured: boolean;
}

interface SourceEntry {
  id: string;
  data: {
    title: string;
    description: string;
    date: Date;
    tags: string[];
    featured: boolean;
  };
}

function toCards(entries: SourceEntry[], base: string, kicker: Kicker): CardEntry[] {
  return entries.map((e) => ({
    href: `${base}/${e.id}/`,
    kicker,
    title: e.data.title,
    description: e.data.description,
    date: e.data.date,
    tags: e.data.tags,
    featured: e.data.featured,
  }));
}

const allArticles = [
  ...toCards(systemDesign, "/system-design", "System Design"),
  ...toCards(coding, "/coding", "Coding"),
  ...toCards(interviews, "/interviews", "Interview"),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const featured = allArticles.filter((a) => a.featured).slice(0, 3);
const fallbackFeatured = allArticles.slice(0, 3);
const featuredCards = featured.length > 0 ? featured : fallbackFeatured;

const latestArticles = allArticles.slice(0, 6);
const latestDigest = digests[0];

const sections = [
  {
    title: "System Design",
    href: "/system-design/",
    description: "Architecture and distributed systems interview prep.",
  },
  {
    title: "Coding",
    href: "/coding/",
    description: "Algorithms, patterns, and interview problems.",
  },
  {
    title: "Interview Experiences",
    href: "/interviews/",
    description: "Real interview notes, formats, and lessons learned.",
  },
  {
    title: "Engineering Digest",
    href: "/eng-digest/",
    description: "Daily summaries from top engineering blogs.",
  },
];
---

<BaseLayout
  title="Eng Knowledge"
  description="Practical notes on system design, coding, engineering interviews, and real-world systems."
>
  <section class="hero">
    <div class="wrap">
      <h1>Engineering Interview &amp; Systems Knowledge</h1>
      <p class="hero-sub">
        Practical notes on system design, coding, engineering interviews, and real-world
        systems.
      </p>
    </div>
  </section>

  {featuredCards.length > 0 && (
    <section class="wrap section">
      <h2>Featured</h2>
      <div class="card-grid">
        {featuredCards.map((card) => (
          <ArticleCard
            href={card.href}
            kicker={card.kicker}
            title={card.title}
            description={card.description}
            date={card.date}
            tags={card.tags}
          />
        ))}
      </div>
    </section>
  )}

  <section class="wrap section">
    <h2>Explore</h2>
    <div class="card-grid">
      {sections.map((s) => (
        <a class="card explore-card" href={withBase(s.href)}>
          <h3>{s.title}</h3>
          <p class="muted">{s.description}</p>
        </a>
      ))}
    </div>
  </section>

  {latestArticles.length > 0 && (
    <section class="wrap section">
      <h2>Latest Articles</h2>
      <div class="card-grid">
        {latestArticles.map((card) => (
          <ArticleCard
            href={card.href}
            kicker={card.kicker}
            title={card.title}
            description={card.description}
            date={card.date}
            tags={card.tags}
          />
        ))}
      </div>
    </section>
  )}

  {latestDigest && (
    <section class="wrap section">
      <h2>Latest Engineering Digest</h2>
      <div class="digest-highlight">
        <DigestCard
          href={`/eng-digest/${latestDigest.id}/`}
          date={latestDigest.data.date}
          articleCount={latestDigest.data.articleCount}
          sourceCount={latestDigest.data.sourceCount}
          sources={latestDigest.data.sources}
        />
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding: 64px 0 40px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-raised);
  }
  .hero h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    max-width: 760px;
    margin: 0 0 14px;
  }
  .hero-sub {
    max-width: 620px;
    font-size: 1.12rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .section {
    padding: 44px 0;
  }
  .section h2 {
    margin: 0 0 20px;
    font-size: 1.4rem;
  }

  .explore-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .explore-card h3 {
    margin: 0;
  }
  .explore-card p {
    margin: 0;
  }

  .digest-highlight {
    max-width: 420px;
  }
</style>
