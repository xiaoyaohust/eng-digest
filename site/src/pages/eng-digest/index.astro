---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DigestCard from "@/components/DigestCard.astro";
import WeeklyDigestCard from "@/components/WeeklyDigestCard.astro";
import { withBase } from "@/lib/url";
import { publishedDigests, publishedWeeklyDigests, DIGEST_PAGE_SIZE } from "@/lib/content";
import Pagination from "@/components/Pagination.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";

const [digests, weeklyDigests] = await Promise.all([publishedDigests(), publishedWeeklyDigests()]);
const latestWeek = weeklyDigests[0];
const pageDigests = digests.slice(0, DIGEST_PAGE_SIZE);
const totalPages = Math.ceil(digests.length / DIGEST_PAGE_SIZE);
const monthCounts = digests.reduce((map, entry) => {
  const month = entry.data.date.toISOString().slice(0, 7);
  map.set(month, (map.get(month) ?? 0) + 1);
  return map;
}, new Map<string, number>());
const months = [...monthCounts.entries()];
const years = [...new Set(months.map(([month]) => month.slice(0,4)))];
const monthLabel = (month: string) => new Intl.DateTimeFormat("en", { month:"long", year:"numeric", timeZone:"UTC" }).format(new Date(`${month}-01T12:00:00Z`));
---

<BaseLayout
  title="Engineering Digest"
  description="Daily, automatically generated summaries of engineering blog posts from top tech companies."
>
  <div class="wrap section">
    <div class="section-header">
      <div>
        <h1>Engineering Digest</h1>
        <p class="muted section-intro">
          A daily digest of engineering blog posts, generated automatically by the
          <code>eng_digest</code> Python pipeline — no manual curation, no AI APIs.
        </p>
      </div>
      <a class="rss-link" href={withBase("/rss.xml")}><span></span> RSS SIGNAL</a>
    </div>

    <div class="section-status"><span>MODULE 04</span><span>{digests.length} DIGESTS</span><span>AUTOMATED / STATIC / DAILY</span></div>

    {latestWeek && (
      <section class="weekly-feature">
        <div class="weekly-copy">
          <span class="eyebrow">NEW / WEEKLY SYNTHESIS</span>
          <h2>Zoom out from the daily feed.</h2>
          <p>
            See which engineering topics and sources dominated the week, plus a short list
            of representative articles worth reading.
          </p>
          <a href={withBase("/eng-digest/weekly/")}>VIEW ALL WEEKLY REPORTS →</a>
        </div>
        <WeeklyDigestCard
          href={`/eng-digest/weekly/${latestWeek.id}/`}
          weekStart={latestWeek.data.weekStart}
          weekEnd={latestWeek.data.weekEnd}
          articleCount={latestWeek.data.articleCount}
          digestCount={latestWeek.data.digestCount}
          topTopics={latestWeek.data.topTopics}
          complete={latestWeek.data.complete}
        />
      </section>
    )}

    <NewsletterSignup />

    <section class="month-archive" aria-labelledby="month-archive-title">
      <div><span class="eyebrow">BROWSE BY DATE</span><h2 id="month-archive-title">Year & month archive</h2><div class="year-links">{years.map((year) => <a href={withBase(`/eng-digest/archive/${year}/`)}>{year} →</a>)}</div></div>
      <div class="month-links">
        {months.map(([month, count]) => <a href={withBase(`/eng-digest/archive/${month}/`)}><span>{monthLabel(month)}</span><small>{count} builds</small></a>)}
      </div>
    </section>

    <div class="daily-heading">
      <div><span class="eyebrow">DAILY ARCHIVE</span><h2>Daily signal logs</h2></div>
      <span>{digests.length} BUILDS</span>
    </div>

    <div class="card-grid">
      {pageDigests.map((entry) => (
        <DigestCard
          href={`/eng-digest/${entry.id}/`}
          date={entry.data.date}
          articleCount={entry.data.articleCount}
          sourceCount={entry.data.sourceCount}
          sources={entry.data.sources}
        />
      ))}
    </div>
    <Pagination currentPage={1} totalPages={totalPages} />

    {digests.length === 0 && (
      <p class="muted">
        No digests found. Run <code>npm run import-digests</code> to import
        <code>../digests/digest-*.md</code>.
      </p>
    )}
  </div>
</BaseLayout>

<style>
  .section {
    padding: 56px 0 80px;
  }
  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }
  .section-intro {
    max-width: 640px;
    margin: 14px 0 0;
  }
  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .rss-link:hover { background: var(--color-bg-raised); text-decoration: none; }
  .rss-link span { width: 6px; height: 6px; border-radius: 50%; background: var(--color-signal); }
  .section-status {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-bottom: 30px;
    padding: 10px 12px;
    border-block: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
  }
  .weekly-feature {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(360px, 1.15fr);
    gap: 36px;
    align-items: center;
    margin: 36px 0 64px;
    padding: clamp(24px, 4vw, 46px);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-raised) 88%, transparent);
  }
  .weekly-copy h2,
  .daily-heading h2 {
    margin: 8px 0 14px;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .weekly-copy p { max-width: 500px; color: var(--color-text-muted); }
  .weekly-copy > a { display: inline-block; margin-top: 10px; font-family: var(--font-mono); font-size: 0.66rem; font-weight: 750; }
  .daily-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
  .daily-heading > span { color: var(--color-text-muted); font-family: var(--font-mono); font-size: 0.62rem; }
  .month-archive { display:grid; grid-template-columns:210px minmax(0,1fr); gap:28px; margin:42px 0 62px; padding:24px; border:1px solid var(--color-border); background:var(--color-bg-inset); }
  .month-archive h2 { margin:7px 0 0; font-family:var(--font-display); font-size:1.55rem; letter-spacing:-.03em; }
  .year-links { display:flex; flex-wrap:wrap; gap:7px; margin-top:15px; }
  .year-links a { padding:5px 7px; border:1px solid var(--color-border); font-family:var(--font-mono); font-size:.61rem; }
  .month-links { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:7px; }
  .month-links a { display:flex; justify-content:space-between; gap:8px; padding:8px 9px; border:1px solid var(--color-border); background:var(--color-bg-raised); font-family:var(--font-mono); font-size:.61rem; }
  .month-links a:hover { border-color:var(--color-accent); text-decoration:none; }
  .month-links small { color:var(--color-text-faint); }
  @media (max-width: 820px) {
    .weekly-feature { grid-template-columns: 1fr; }
    .month-archive { grid-template-columns:1fr; }
  }
</style>
