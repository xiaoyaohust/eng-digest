---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DigestCard from "@/components/DigestCard.astro";
import WeeklyDigestCard from "@/components/WeeklyDigestCard.astro";
import { withBase } from "@/lib/url";
import { publishedDigests, publishedWeeklyDigests } from "@/lib/content";

const [digests, weeklyDigests] = await Promise.all([publishedDigests(), publishedWeeklyDigests()]);
const latestWeek = weeklyDigests[0];
---

<BaseLayout
  title="Engineering Digest"
  description="Daily, automatically generated summaries of engineering blog posts from top tech companies."
>
  <div class="wrap section">
    <div class="section-header">
      <div>
        <h1>Engineering Digest</h1>
        <p class="muted section-intro">
          A daily digest of engineering blog posts, generated automatically by the
          <code>eng_digest</code> Python pipeline — no manual curation, no AI APIs.
        </p>
      </div>
      <a class="rss-link" href={withBase("/rss.xml")}><span></span> RSS SIGNAL</a>
    </div>

    <div class="section-status"><span>MODULE 04</span><span>{digests.length} DIGESTS</span><span>AUTOMATED / STATIC / DAILY</span></div>

    {latestWeek && (
      <section class="weekly-feature">
        <div class="weekly-copy">
          <span class="eyebrow">NEW / WEEKLY SYNTHESIS</span>
          <h2>Zoom out from the daily feed.</h2>
          <p>
            See which engineering topics and sources dominated the week, plus a short list
            of representative articles worth reading.
          </p>
          <a href={withBase("/eng-digest/weekly/")}>VIEW ALL WEEKLY REPORTS →</a>
        </div>
        <WeeklyDigestCard
          href={`/eng-digest/weekly/${latestWeek.id}/`}
          weekStart={latestWeek.data.weekStart}
          weekEnd={latestWeek.data.weekEnd}
          articleCount={latestWeek.data.articleCount}
          digestCount={latestWeek.data.digestCount}
          topTopics={latestWeek.data.topTopics}
          complete={latestWeek.data.complete}
        />
      </section>
    )}

    <div class="daily-heading">
      <div><span class="eyebrow">DAILY ARCHIVE</span><h2>Daily signal logs</h2></div>
      <span>{digests.length} BUILDS</span>
    </div>

    <div class="card-grid">
      {digests.map((entry) => (
        <DigestCard
          href={`/eng-digest/${entry.id}/`}
          date={entry.data.date}
          articleCount={entry.data.articleCount}
          sourceCount={entry.data.sourceCount}
          sources={entry.data.sources}
        />
      ))}
    </div>

    {digests.length === 0 && (
      <p class="muted">
        No digests found. Run <code>npm run import-digests</code> to import
        <code>../digests/digest-*.md</code>.
      </p>
    )}
  </div>
</BaseLayout>

<style>
  .section {
    padding: 56px 0 80px;
  }
  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }
  .section-intro {
    max-width: 640px;
    margin: 14px 0 0;
  }
  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .rss-link:hover { background: var(--color-bg-raised); text-decoration: none; }
  .rss-link span { width: 6px; height: 6px; border-radius: 50%; background: var(--color-signal); }
  .section-status {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-bottom: 30px;
    padding: 10px 12px;
    border-block: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
  }
  .weekly-feature {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(360px, 1.15fr);
    gap: 36px;
    align-items: center;
    margin: 36px 0 64px;
    padding: clamp(24px, 4vw, 46px);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-raised) 88%, transparent);
  }
  .weekly-copy h2,
  .daily-heading h2 {
    margin: 8px 0 14px;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .weekly-copy p { max-width: 500px; color: var(--color-text-muted); }
  .weekly-copy > a { display: inline-block; margin-top: 10px; font-family: var(--font-mono); font-size: 0.66rem; font-weight: 750; }
  .daily-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
  .daily-heading > span { color: var(--color-text-muted); font-family: var(--font-mono); font-size: 0.62rem; }
  @media (max-width: 820px) {
    .weekly-feature { grid-template-columns: 1fr; }
  }
</style>
