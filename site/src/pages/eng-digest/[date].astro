---
import { getCollection, render } from "astro:content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("generated-digests")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return entries.map((entry, index, all) => ({
    params: { date: entry.id },
    props: {
      entry,
      prevEntry: all[index + 1], // older
      nextEntry: all[index - 1], // newer
    },
  }));
}

const { entry, prevEntry, nextEntry } = Astro.props;
const { Content, headings } = await render(entry);

const description = `Engineering digest for ${entry.data.date.toISOString().slice(0, 10)}${
  entry.data.articleCount ? ` — ${entry.data.articleCount} articles` : ""
}${entry.data.sourceCount ? ` from ${entry.data.sourceCount} sources` : ""}.`;
---

<ArticleLayout
  title={entry.data.title}
  description={description}
  kicker="Engineering Digest"
  date={entry.data.date}
  headings={headings}
  prev={prevEntry && { title: `Digest — ${prevEntry.id}`, href: `/eng-digest/${prevEntry.id}/` }}
  next={nextEntry && { title: `Digest — ${nextEntry.id}`, href: `/eng-digest/${nextEntry.id}/` }}
>
  {entry.data.sources && entry.data.sources.length > 0 && (
    <p class="digest-sources tag-list" aria-label="Sources in this digest">
      {entry.data.sources.map((source) => (
        <span class="tag">{source}</span>
      ))}
    </p>
  )}
  <Content />
</ArticleLayout>

<style>
  .digest-sources {
    margin: -8px 0 24px;
  }
</style>
