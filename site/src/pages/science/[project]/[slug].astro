---
import { render } from "astro:content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { published, allCandidates, findRelated } from "@/lib/content";
import { readingTime } from "@/lib/url";
import { scienceArticleHref, scienceProjects, SCIENCE_SECTION_NAME } from "@/data/scienceProjects";

export async function getStaticPaths() {
  const entries = await published("science");
  return entries.map((entry) => ({ params: { project: entry.data.project, slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const project = scienceProjects[entry.data.project];
const { Content, headings } = await render(entry);
const related = findRelated(entry.data.tags, await allCandidates(), scienceArticleHref(entry));
const socialImage = entry.data.socialImage ?? {
  src: `/social/auto/science/${entry.id}.png`,
  alt: entry.data.socialTitle ?? entry.data.title,
  width: 1200,
  height: 627,
};
---

<ArticleLayout
  title={entry.data.title} description={entry.data.description}
  lang={entry.data.lang} kicker={`${SCIENCE_SECTION_NAME} / ${project.name}`}
  date={entry.data.date} updated={entry.data.updated} tags={entry.data.tags}
  readingMinutes={readingTime(entry.body ?? "")} headings={headings}
  socialImage={socialImage} related={related} sectionHref={`/science/${entry.data.project}/`}
  shareHashtags={["Astrophysics", "ScientificComputing", "OpenScience"]}
  breadcrumbParents={[{ title: SCIENCE_SECTION_NAME, href: "/science/" }, { title: project.name, href: `/science/${entry.data.project}/` }]}
>
  <Content />
</ArticleLayout>
