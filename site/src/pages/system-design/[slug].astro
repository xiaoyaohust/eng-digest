---
import { render } from "astro:content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { published, findRelated, allCandidates } from "@/lib/content";
import { readingTime } from "@/lib/url";
import { findLearningPathForHref } from "@/data/learningPaths";

export async function getStaticPaths() {
  const entries = await published("system-design");
  return entries.map((entry, index, all) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prevEntry: all[index + 1],
      nextEntry: all[index - 1],
    },
  }));
}

const { entry, prevEntry, nextEntry } = Astro.props;
const { Content, headings } = await render(entry);

const candidates = await allCandidates();
const related = findRelated(entry.data.tags, candidates, `/system-design/${entry.id}/`);
const articleHref = `/system-design/${entry.id}/`;
const path = findLearningPathForHref(articleHref);
const socialImage = entry.data.socialImage ?? {
  src: `/social/auto/system-design/${entry.id}.png`,
  alt: `${entry.data.title} social preview`,
  width: 1200,
  height: 627,
};
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  kicker="System Design"
  date={entry.data.date}
  updated={entry.data.updated}
  tags={entry.data.tags}
  readingMinutes={readingTime(entry.body ?? "")}
  headings={headings}
  prev={prevEntry && { title: prevEntry.data.title, href: `/system-design/${prevEntry.id}/` }}
  next={nextEntry && { title: nextEntry.data.title, href: `/system-design/${nextEntry.id}/` }}
  related={related}
  practice={entry.data.practice}
  practiceKey={`system-design/${entry.id}`}
  socialImage={socialImage}
  sectionHref="/system-design/"
  relatedPath={path && { title: path.title, href: `/learning-paths/${path.slug}/` }}
>
  <Content />
</ArticleLayout>
