---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { published } from "@/lib/content";

const articles = await published("system-design");
---

<BaseLayout
  title="System Design"
  description="Architecture and distributed systems interview prep."
>
  <div class="wrap section">
    <h1>System Design</h1>
    <p class="muted section-intro">Architecture and distributed systems interview prep.</p>
    <div class="card-grid">
      {articles.map((entry) => (
        <ArticleCard
          href={`/system-design/${entry.id}/`}
          kicker="System Design"
          title={entry.data.title}
          description={entry.data.description}
          date={entry.data.date}
          tags={entry.data.tags}
        />
      ))}
    </div>
    {articles.length === 0 && <p class="muted">No articles yet.</p>}
  </div>
</BaseLayout>

<style>
  .section {
    padding: 44px 0 64px;
  }
  .section-intro {
    margin: -6px 0 28px;
  }
</style>
