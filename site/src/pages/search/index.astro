---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Search"
  description="Search System Design, Coding, Engineering Field Notes, and Engineering Digest content."
>
  <div class="wrap section">
    <h1>Search</h1>
    <p class="muted section-intro">
      Static full-text search across System Design, Coding, Engineering Field Notes, and Engineering Digest —
      indexed at build time, no server involved.
    </p>
    <div id="pagefind-search"></div>
    <p id="search-fallback" class="muted" hidden>
      Search index not found. It's only built as part of <code>npm run build</code>
      (which runs Pagefind) — try <code>npm run build &amp;&amp; npm run preview</code>
      to test search locally; it works normally once deployed.
    </p>
  </div>
</BaseLayout>

<script>
  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src = src;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error(`Failed to load ${src}`));
      document.head.appendChild(script);
    });
  }

  const base = import.meta.env.BASE_URL;

  const cssLink = document.createElement("link");
  cssLink.rel = "stylesheet";
  cssLink.href = `${base}pagefind/pagefind-ui.css`;
  document.head.appendChild(cssLink);

  loadScript(`${base}pagefind/pagefind-ui.js`)
    .then(() => {
      // @ts-expect-error — PagefindUI is loaded onto window by the script above.
      new window.PagefindUI({ element: "#pagefind-search", showSubResults: true });
    })
    .catch(() => {
      document.getElementById("search-fallback")?.removeAttribute("hidden");
    });
</script>

<style>
  .section {
    padding: 56px 0 80px;
  }
  .section-intro {
    max-width: 620px;
  }
  #pagefind-search {
    margin-top: 28px;
  }
  #pagefind-search :global(.pagefind-ui__search-input) {
    border: 1px solid var(--color-border-strong);
    border-radius: 7px;
    background: var(--color-bg-raised);
    color: var(--color-text);
    box-shadow: var(--shadow-card);
    font-family: var(--font-mono);
  }
  #pagefind-search :global(.pagefind-ui__result) { border-color: var(--color-border); }
  #pagefind-search :global(.pagefind-ui__result-title) { font-family: var(--font-display); }
</style>
