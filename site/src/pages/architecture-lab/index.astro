---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/url";
---

<BaseLayout
  title="Architecture Decision Lab 2.0"
  description="Compare architecture strategies, detect conflicting constraints, and estimate capacity without AI or a backend."
>
  <div class="lab-page" data-architecture-lab>
    <header class="lab-hero">
      <div class="wrap lab-hero-grid">
        <div>
          <span class="eyebrow">INTERACTIVE / DETERMINISTIC RULE ENGINE</span>
          <h1>Architecture<br />Decision Lab <em>2.0</em></h1>
          <p>
            Shape a workload, expose impossible combinations, and compare three defensible
            architectures. Everything runs locally in your browser—no AI, account, or backend.
          </p>
        </div>
        <div class="signal-panel" aria-hidden="true">
          <div><span>MODEL</span><strong>V2.0</strong></div>
          <div><span>EXECUTION</span><strong>LOCAL</strong></div>
          <div><span>OUTPUT</span><strong>EXPLAINABLE</strong></div>
          <small>CONSTRAINTS → RISKS → OPTIONS → DECISION</small>
        </div>
      </div>
    </header>

    <div class="wrap lab-workbench">
      <section class="control-panel" aria-labelledby="constraints-title">
        <div class="panel-head">
          <div><span class="eyebrow">01 / CONSTRAINTS</span><h2 id="constraints-title">Shape the workload</h2></div>
          <button type="button" class="quiet-button" data-reset>Reset</button>
        </div>

        <div class="presets" aria-label="Architecture presets">
          <button type="button" data-preset="api" aria-pressed="false">High-traffic API</button>
          <button type="button" data-preset="logs" aria-pressed="false">Log platform</button>
          <button type="button" data-preset="ledger" aria-pressed="false">Financial ledger</button>
          <button type="button" data-preset="feed" aria-pressed="false">Global feed</button>
        </div>

        <div class="control-group">
          <p>TRAFFIC SHAPE</p>
          <div class="controls-grid">
            <label>
              <span>Baseline requests / second</span>
              <strong data-qps-output>10,000</strong>
              <input type="range" min="100" max="1000000" step="100" value="10000" data-input="qps" />
              <small>100 → 1,000,000 requests/second</small>
            </label>
            <label>
              <span>Read / write mix</span>
              <strong data-read-output>80% / 20%</strong>
              <input type="range" min="0" max="100" step="5" value="80" data-input="readPercent" />
              <small>Reads on the left, writes on the right</small>
            </label>
            <label>
              <span>Burst multiplier</span>
              <select data-input="burstFactor">
                <option value="1">1× steady</option><option value="2" selected>2×</option>
                <option value="3">3×</option><option value="5">5×</option><option value="10">10×</option>
              </select>
            </label>
            <label>
              <span>Average payload size</span>
              <strong data-size-output>2 KB</strong>
              <input type="range" min="1" max="1024" step="1" value="2" data-input="sizeKb" />
              <small>1 KB → 1 MB per write</small>
            </label>
            <label>
              <span>Workload shape</span>
              <select data-input="workload">
                <option value="transactional" selected>Transactional</option>
                <option value="key-value">Key-value access</option>
                <option value="event-stream">Event stream</option>
                <option value="analytics">Analytical scans</option>
              </select>
            </label>
            <label>
              <span>Target p99 latency</span>
              <select data-input="latency">
                <option value="20">20 ms</option><option value="50" selected>50 ms</option>
                <option value="100">100 ms</option><option value="250">250 ms</option><option value="1000">1 second</option>
              </select>
            </label>
          </div>
        </div>

        <div class="control-group">
          <p>CORRECTNESS + RESILIENCE</p>
          <div class="controls-grid">
            <label>
              <span>Consistency</span>
              <select data-input="consistency">
                <option value="eventual">Eventual</option>
                <option value="read-your-writes">Read your writes</option>
                <option value="strong" selected>Strong</option>
              </select>
            </label>
            <label>
              <span>Availability target</span>
              <select data-input="availability">
                <option value="99.9">99.9%</option><option value="99.99" selected>99.99%</option><option value="99.999">99.999%</option>
              </select>
            </label>
            <label>
              <span>Durability target</span>
              <select data-input="durability">
                <option value="standard">Standard</option><option value="high" selected>High</option><option value="zero-loss">Zero acknowledged loss</option>
              </select>
            </label>
            <label>
              <span>Ordering requirement</span>
              <select data-input="ordering">
                <option value="none">No ordering</option><option value="per-key" selected>Per-key ordering</option><option value="global">Global ordering</option>
              </select>
            </label>
            <label>
              <span>Geographic footprint</span>
              <select data-input="regions">
                <option value="1" selected>Single region</option><option value="2">Primary + failover</option><option value="3">Active in 3+ regions</option>
              </select>
            </label>
            <label>
              <span>Replica factor</span>
              <select data-input="replicas">
                <option value="1">1 replica</option><option value="2">2 replicas</option><option value="3" selected>3 replicas</option><option value="5">5 replicas</option>
              </select>
            </label>
          </div>
        </div>

        <div class="control-group">
          <p>DATA ECONOMICS</p>
          <div class="controls-grid">
            <label>
              <span>Retention period</span>
              <strong data-retention-output>30 days</strong>
              <input type="range" min="1" max="365" step="1" value="30" data-input="retention" />
              <small>1 → 365 days</small>
            </label>
            <label>
              <span>Expected compression</span>
              <select data-input="compression">
                <option value="1">None</option><option value="2" selected>2×</option><option value="3">3×</option><option value="4">4×</option>
              </select>
            </label>
          </div>
        </div>

        <div class="scenario-store">
          <span class="eyebrow">SAVED LOCALLY</span>
          <div class="save-row">
            <input type="text" maxlength="40" placeholder="Scenario name" aria-label="Scenario name" data-scenario-name />
            <button type="button" data-save-scenario>Save</button>
          </div>
          <p data-storage-note>Saved designs stay in this browser.</p>
          <div class="saved-list" data-saved-list></div>
        </div>
      </section>

      <section class="result-panel" aria-labelledby="recommendation-title">
        <div class="panel-head result-head">
          <div><span class="eyebrow">02 / DECISION OUTPUT</span><h2 id="recommendation-title">Recommended starting point</h2></div>
          <div class="output-actions">
            <button type="button" class="quiet-button" data-copy-link>Copy link</button>
            <button type="button" class="quiet-button" data-copy-summary>Copy brief</button>
            <button type="button" class="quiet-button" data-download>Download .md</button>
          </div>
        </div>

        <p class="lab-live-status" data-lab-status aria-live="polite"></p>

        <div class="constraint-review" data-constraint-review>
          <div class="section-heading compact">
            <div><span class="eyebrow">CONSTRAINT CHECK</span><h2>Feasibility before architecture</h2></div>
            <strong data-finding-count>1 RISK</strong>
          </div>
          <div class="finding-list" data-finding-list>
            <article class="finding warning"><span>WARNING</span><h3>Availability depends on one region</h3><p>A multi-zone design may meet normal failures, but a regional event exceeds the requested availability posture.</p></article>
          </div>
        </div>

        <div class="metric-grid">
          <article><span>PEAK READ / WRITE</span><strong data-metric="rw">16,000 / 4,000</strong><small>requests per second</small></article>
          <article><span>WRITE INGRESS</span><strong data-metric="ingress">7.8 MB/s</strong><small>peak, uncompressed</small></article>
          <article><span>DAILY LOGICAL</span><strong data-metric="daily">0.3 TB</strong><small>baseline writes</small></article>
          <article><span>PHYSICAL DATA</span><strong data-metric="stored">17.4 TB</strong><small>compression + replicas + 20%</small></article>
          <article><span>PARTITIONS</span><strong data-metric="partitions">3</strong><small>at ~70% utilization</small></article>
          <article><span>BROKERS</span><strong data-metric="brokers">3</strong><small>throughput + hot storage</small></article>
        </div>

        <div class="architecture-flow" aria-label="Recommended architecture flow">
          <div class="flow-node"><small>EDGE</small><strong data-node="edge">Load Balancer</strong></div><span>→</span>
          <div class="flow-node"><small>COMPUTE</small><strong data-node="compute">Stateless Service</strong></div><span>→</span>
          <div class="flow-node" data-flow-buffer><small>BUFFER</small><strong data-node="buffer">Durable queue with replay</strong></div><span data-flow-buffer>→</span>
          <div class="flow-node"><small>STATE</small><strong data-node="state">Relational database with synchronous replicas</strong></div>
        </div>

        <div class="decision-grid">
          <article><span class="decision-code">D01 / DATA</span><h3 data-decision="database">Relational database with synchronous replicas</h3><p data-reason="database"></p></article>
          <article><span class="decision-code">D02 / CACHE</span><h3 data-decision="cache">Versioned read-through cache</h3><p data-reason="cache"></p></article>
          <article><span class="decision-code">D03 / STREAM</span><h3 data-decision="stream">Durable queue with replay</h3><p data-reason="stream"></p></article>
          <article><span class="decision-code">D04 / STORAGE</span><h3 data-decision="storage">Object storage as durable archive</h3><p data-reason="storage"></p></article>
          <article><span class="decision-code">D05 / REPLICATION</span><h3 data-decision="replication">3-copy synchronous replication across availability zones</h3><p data-reason="replication"></p></article>
          <article><span class="decision-code">D06 / READ PATH</span><h3 data-decision="readPath">Edge routing → cache → regional read model</h3><p data-reason="readPath"></p></article>
        </div>

        <section class="candidate-section" aria-labelledby="candidate-title">
          <div class="section-heading">
            <div><span class="eyebrow">03 / OPTION SPACE</span><h2 id="candidate-title">Compare, do not guess</h2></div>
            <p>Fit is deterministic and relative to the current constraints.</p>
          </div>
          <p class="blocked-notice" data-blocked-notice hidden></p>
          <div class="candidate-grid">
            {[0, 1, 2].map(() => (
              <article class="candidate-card" data-candidate-card>
                <div class="candidate-top"><span data-candidate-label>OPTION</span><strong data-candidate-fit>0%</strong></div>
                <h3 data-candidate-title>Architecture option</h3>
                <p data-candidate-summary></p>
                <code data-candidate-topology></code>
                <div class="score-list">
                  {(["latency", "consistency", "availability", "cost", "simplicity"] as const).map((score) => (
                    <div><span>{score}</span><b class="score-bar"><i data-score-bar={score}></i></b><strong data-score-value={score}>0/5</strong></div>
                  ))}
                </div>
                <dl><div><dt>STRENGTH</dt><dd data-candidate-strength></dd></div><div><dt>RISK</dt><dd data-candidate-risk></dd></div></dl>
              </article>
            ))}
          </div>
        </section>

        <div class="tradeoffs">
          <div><span class="eyebrow">PRESSURE POINTS</span><ul data-pressure-list></ul></div>
          <div><span class="eyebrow">EXPLICIT TRADE-OFFS</span><ul data-tradeoff-list></ul></div>
        </div>

        <section class="defense-section" aria-labelledby="defense-title">
          <div class="section-heading">
            <div><span class="eyebrow">04 / INTERVIEW DEFENSE</span><h2 id="defense-title">Defend the design</h2></div>
            <p>Prompts change with the workload. Reveal the talking point only after answering.</p>
          </div>
          <div class="defense-grid">
            {[0, 1, 2, 3].map((_, index) => (
              <article data-defense-card>
                <span>Q{String(index + 1).padStart(2, "0")}</span>
                <h3 data-defense-question>Architecture defense question</h3>
                <button type="button" data-defense-toggle aria-expanded="false">Reveal talking point</button>
                <p data-defense-answer hidden></p>
              </article>
            ))}
          </div>
        </section>

        <div class="lab-next">
          <div><span class="eyebrow">NEXT STEP</span><h2>Validate assumptions with measurements.</h2></div>
          <a href={withBase("/learning-paths/system-design-fundamentals/")}>Open the fundamentals path →</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    buildDesignBrief,
    buildLabQuery,
    labDefaults,
    labPresets,
    parseLabParams,
    recommendArchitecture,
    sanitizeLabValue,
    type ArchitectureCandidate,
    type LabFinding,
    type LabState,
  } from "@/lib/architectureLab";

  type LabControl = HTMLInputElement | HTMLSelectElement;
  interface SavedScenario { id:string; name:string; savedAt:string; state:LabState; }
  const labKeys = Object.keys(labDefaults) as (keyof LabState)[];
  const storageKey = "eng-knowledge:architecture-lab:v2:scenarios";
  const SCENARIO_LIMIT = 12;
  const root = document.querySelector<HTMLElement>("[data-architecture-lab]");
  const inputs: Partial<Record<keyof LabState, LabControl>> = Object.fromEntries(
    Array.from(root?.querySelectorAll<LabControl>("[data-input]") ?? []).map((input) => [input.dataset.input, input])
  );
  let activePreset: string | null = null;
  let designBrief = "";
  let currentShareUrl = "";
  let savedScenarios: SavedScenario[] = [];

  function formatNumber(value: number): string {
    return new Intl.NumberFormat("en-US", { maximumFractionDigits:1, notation:value >= 100_000 ? "compact" : "standard" }).format(value);
  }

  function formatTb(value: number): string {
    return value < 0.1 ? `${formatNumber(value * 1024)} GB` : `${formatNumber(value)} TB`;
  }

  // update() runs on every `input` event, and a slider drag fires dozens per
  // second. The metric readouts genuinely change that often; the findings,
  // option cards and defence prompts almost never do, and re-rendering them
  // costs ~50 DOM writes plus layout each time. Skip the work when the content
  // is identical to what is already on screen.
  const renderedSignatures = new Map<string, string>();
  function changedSince(key: string, value: unknown): boolean {
    const signature = JSON.stringify(value);
    if (renderedSignatures.get(key) === signature) return false;
    renderedSignatures.set(key, signature);
    return true;
  }

  function setText(selector: string, value: string): void {
    const element = root?.querySelector(selector);
    if (element && element.textContent !== value) element.textContent = value;
  }

  function setList(selector: string, items: string[]): void {
    if (!changedSince(`list:${selector}`, items)) return;
    const list = root?.querySelector(selector);
    if (!list) return;
    list.replaceChildren(...items.map((item) => {
      const li = document.createElement("li");
      li.textContent = item;
      return li;
    }));
  }

  function readState(): LabState {
    const state = { ...labDefaults };
    labKeys.forEach((key) => {
      const input = inputs[key];
      if (!input) return;
      const value = sanitizeLabValue(key, input.value);
      if (value !== null) (state[key] as LabState[typeof key]) = value;
    });
    return state;
  }

  function applyState(state: LabState, preset: string | null = null): void {
    labKeys.forEach((key) => {
      const input = inputs[key];
      const safe = sanitizeLabValue(key, state[key]);
      if (safe !== null && input) input.value = String(safe);
    });
    activePreset = preset;
    update();
  }

  function renderFindings(findings: LabFinding[]): void {
    if (!changedSince("findings", findings)) return;
    const list = root?.querySelector("[data-finding-list]");
    if (!list) return;
    list.replaceChildren(...findings.map((finding) => {
      const article = document.createElement("article");
      article.className = `finding ${finding.severity}`;
      const severity = document.createElement("span");
      severity.textContent = finding.severity.toUpperCase();
      const title = document.createElement("h3");
      title.textContent = finding.title;
      const detail = document.createElement("p");
      detail.textContent = finding.detail;
      article.append(severity, title, detail);
      return article;
    }));
    const blockers = findings.filter((item) => item.severity === "blocker").length;
    const warnings = findings.filter((item) => item.severity === "warning").length;
    setText("[data-finding-count]", blockers ? `${blockers} BLOCKER${blockers > 1 ? "S" : ""}` : warnings ? `${warnings} RISK${warnings > 1 ? "S" : ""}` : "PLAUSIBLE");
    if (root) root.dataset.risk = blockers ? "blocker" : warnings ? "warning" : "clear";
  }

  function renderCandidates(candidates: ArchitectureCandidate[], blockerCount: number): void {
    if (!changedSince("candidates", [candidates, blockerCount])) return;
    // With an unresolved blocker the ranking is "least bad", not a design to
    // build — say so next to the fit percentages rather than letting a big
    // "RECOMMENDED / 88% FIT" badge imply the constraints are satisfiable.
    const notice = root?.querySelector<HTMLElement>("[data-blocked-notice]");
    if (notice) {
      notice.hidden = blockerCount === 0;
      notice.textContent = blockerCount === 0
        ? ""
        : `${blockerCount} blocking conflict${blockerCount > 1 ? "s" : ""} above must be resolved first. These options are ranked least-bad under constraints that cannot all hold at once — none of them makes the combination work.`;
    }
    root?.querySelectorAll<HTMLElement>("[data-candidate-card]").forEach((card, index) => {
      const candidate = candidates[index];
      if (!candidate) return;
      card.classList.toggle("recommended", index === 0);
      const write = (selector: string, value: string) => { const node = card.querySelector(selector); if (node) node.textContent = value; };
      write("[data-candidate-label]", index === 0 ? `${blockerCount ? "LEAST BAD" : "RECOMMENDED"} / ${candidate.label}` : candidate.label);
      write("[data-candidate-fit]", `${candidate.fit}% FIT`);
      write("[data-candidate-title]", candidate.title);
      write("[data-candidate-summary]", candidate.summary);
      write("[data-candidate-topology]", candidate.topology);
      write("[data-candidate-strength]", candidate.strength);
      write("[data-candidate-risk]", candidate.risk);
      Object.entries(candidate.scores).forEach(([key, score]) => {
        const bar = card.querySelector<HTMLElement>(`[data-score-bar="${key}"]`);
        if (bar) bar.style.width = `${score * 20}%`;
        write(`[data-score-value="${key}"]`, `${score}/5`);
      });
    });
  }

  function renderDefense(prompts: { question:string; talkingPoint:string }[]): void {
    if (!changedSince("defense", prompts)) return;
    root?.querySelectorAll<HTMLElement>("[data-defense-card]").forEach((card, index) => {
      const prompt = prompts[index];
      if (!prompt) return;
      const question = card.querySelector("[data-defense-question]");
      const answer = card.querySelector<HTMLElement>("[data-defense-answer]");
      const button = card.querySelector<HTMLButtonElement>("[data-defense-toggle]");
      // update() runs on every slider tick, so unconditionally re-hiding the
      // talking point made it impossible to read one while adjusting anything.
      // Only collapse when the prompt itself actually changed.
      const changed = question?.textContent !== prompt.question;
      if (question) question.textContent = prompt.question;
      if (answer) {
        answer.textContent = prompt.talkingPoint;
        if (changed) answer.hidden = true;
      }
      if (button && changed) { button.textContent = "Reveal talking point"; button.setAttribute("aria-expanded", "false"); }
    });
  }

  let urlTimer: ReturnType<typeof setTimeout> | undefined;
  let pendingAnnouncement = "";
  function updateUrl(query: string): void {
    clearTimeout(urlTimer);
    urlTimer = setTimeout(() => {
      try { history.replaceState(null, "", `${location.pathname}?${query}`); } catch { /* Lab still works if History is unavailable. */ }
      const status = root?.querySelector("[data-lab-status]");
      if (status) status.textContent = pendingAnnouncement;
    }, 250);
  }

  function update(): void {
    const state = readState();
    const result = recommendArchitecture(state);
    root?.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.preset === activePreset)));
    setText("[data-qps-output]", formatNumber(state.qps));
    setText("[data-read-output]", `${state.readPercent}% / ${100 - state.readPercent}%`);
    setText("[data-size-output]", state.sizeKb >= 1024 ? "1 MB" : `${formatNumber(state.sizeKb)} KB`);
    setText("[data-retention-output]", `${state.retention} days`);
    setText('[data-metric="rw"]', `${formatNumber(result.peakReadQps)} / ${formatNumber(result.peakWriteQps)}`);
    setText('[data-metric="ingress"]', `${formatNumber(result.ingressMb)} MB/s`);
    setText('[data-metric="daily"]', formatTb(result.dailyTb));
    setText('[data-metric="stored"]', formatTb(result.physicalStoredTb));
    setText('[data-metric="partitions"]', String(result.partitions));
    setText('[data-metric="brokers"]', String(result.brokers));

    ([
      ["database", result.database, result.databaseReason], ["cache", result.cache, result.cacheReason],
      ["stream", result.stream, result.streamReason], ["storage", result.storage, result.storageReason],
      ["replication", result.replication, result.replicationReason], ["readPath", result.readPath, result.readPathReason],
    ] as const).forEach(([key, decision, reason]) => {
      setText(`[data-decision="${key}"]`, decision);
      setText(`[data-reason="${key}"]`, reason);
    });
    setText('[data-node="edge"]', state.regions > 1 ? "Geo Router" : "Load Balancer");
    setText('[data-node="compute"]', result.highScale ? "Autoscaled Services" : "Stateless Service");
    setText('[data-node="buffer"]', result.stream);
    setText('[data-node="state"]', result.database);
    root?.querySelectorAll<HTMLElement>("[data-flow-buffer]").forEach((element) => { element.hidden = result.peakWriteQps === 0; });
    setList("[data-pressure-list]", result.pressures);
    setList("[data-tradeoff-list]", result.tradeoffs);
    renderFindings(result.findings);
    renderCandidates(result.candidates, result.blockerCount);
    renderDefense(result.defensePrompts);
    const query = buildLabQuery(state);
    currentShareUrl = `${location.origin}${location.pathname}?${query}`;
    designBrief = buildDesignBrief(state, result, currentShareUrl);
    pendingAnnouncement = `${formatNumber(result.peakQps)} peak requests per second. ${result.findings.length} constraint finding(s)${result.feasible ? "" : `, including ${result.blockerCount} blocker(s) that must be resolved first`}. ${result.feasible ? "Recommended option" : "Least-bad option"}: ${result.recommendedCandidate.title} at ${result.recommendedCandidate.fit}% fit.`;
    updateUrl(query);
  }

  function copyText(text: string, button: HTMLButtonElement, success: string): void {
    const original = button.textContent ?? "Copy";
    const done = () => { button.textContent = success; setTimeout(() => { button.textContent = original; }, 1600); };
    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(text).then(done).catch(() => button.textContent = "Copy unavailable");
    } else button.textContent = "Copy unavailable";
  }

  // Date.now() alone collides when two saves land in the same millisecond, and
  // delete filters by id — so a collision would remove both entries at once.
  let scenarioCounter = 0;
  function newScenarioId(): string {
    const unique = globalThis.crypto?.randomUUID?.();
    if (unique) return unique;
    scenarioCounter += 1;
    return `${Date.now()}-${scenarioCounter}`;
  }

  function loadScenarios(): SavedScenario[] {
    try {
      const parsed = JSON.parse(localStorage.getItem(storageKey) ?? "[]");
      if (!Array.isArray(parsed)) return [];
      return parsed.flatMap((item): SavedScenario[] => {
        if (!item || typeof item !== "object" || typeof item.id !== "string" || typeof item.name !== "string" || !item.state) return [];
        const params = new URLSearchParams();
        labKeys.forEach((key) => params.set(key, String(item.state[key] ?? "")));
        return [{ id:item.id, name:item.name.slice(0, 40), savedAt:typeof item.savedAt === "string" ? item.savedAt : "", state:parseLabParams(params) }];
      }).slice(0, SCENARIO_LIMIT);
    } catch { return []; }
  }

  function persistScenarios(): void {
    try { localStorage.setItem(storageKey, JSON.stringify(savedScenarios)); setText("[data-storage-note]", "Saved designs stay in this browser."); }
    catch { setText("[data-storage-note]", "Browser storage is unavailable; this design was not saved."); }
  }

  function renderSavedScenarios(): void {
    const list = root?.querySelector("[data-saved-list]");
    if (!list) return;
    if (!savedScenarios.length) {
      const empty = document.createElement("span"); empty.className = "saved-empty"; empty.textContent = "No saved scenarios yet."; list.replaceChildren(empty); return;
    }
    list.replaceChildren(...savedScenarios.map((scenario) => {
      const row = document.createElement("div");
      const load = document.createElement("button"); load.type = "button"; load.className = "saved-name"; load.textContent = scenario.name;
      load.addEventListener("click", () => applyState(scenario.state));
      const remove = document.createElement("button"); remove.type = "button"; remove.className = "saved-remove"; remove.textContent = "Delete"; remove.setAttribute("aria-label", `Delete ${scenario.name}`);
      remove.addEventListener("click", () => { savedScenarios = savedScenarios.filter((item) => item.id !== scenario.id); persistScenarios(); renderSavedScenarios(); });
      row.append(load, remove); return row;
    }));
  }

  root?.querySelectorAll<LabControl>("[data-input]").forEach((input) => input.addEventListener("input", () => { activePreset = null; update(); }));
  root?.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((button) => button.addEventListener("click", () => {
    const key = button.dataset.preset ?? "";
    if (labPresets[key]) applyState(labPresets[key], key);
  }));
  root?.querySelector("[data-reset]")?.addEventListener("click", () => applyState(labDefaults));
  root?.querySelector<HTMLButtonElement>("[data-copy-link]")?.addEventListener("click", (event) => copyText(currentShareUrl, event.currentTarget as HTMLButtonElement, "Link copied"));
  root?.querySelector<HTMLButtonElement>("[data-copy-summary]")?.addEventListener("click", (event) => copyText(designBrief, event.currentTarget as HTMLButtonElement, "Brief copied"));
  root?.querySelector<HTMLButtonElement>("[data-download]")?.addEventListener("click", () => {
    const url = URL.createObjectURL(new Blob([designBrief], { type:"text/markdown;charset=utf-8" }));
    const link = document.createElement("a"); link.href = url; link.download = "architecture-design-brief.md"; link.click();
    // Revoking in the same tick can cancel the download before the browser has
    // finished reading the blob (Firefox in particular); let the click settle.
    setTimeout(() => URL.revokeObjectURL(url), 10_000);
  });
  root?.querySelector("[data-save-scenario]")?.addEventListener("click", () => {
    const nameInput = root.querySelector<HTMLInputElement>("[data-scenario-name]");
    const name = (nameInput?.value.trim() || `Scenario ${savedScenarios.length + 1}`).slice(0, 40);
    const saved: SavedScenario = { id:newScenarioId(), name, savedAt:new Date().toISOString(), state:readState() };
    const next = [saved, ...savedScenarios];
    const dropped = next.length - SCENARIO_LIMIT;
    savedScenarios = next.slice(0, SCENARIO_LIMIT);
    persistScenarios();
    // Silently discarding the oldest design is how someone loses work they
    // meant to keep, so name what went.
    if (dropped > 0) {
      const removed = next.slice(SCENARIO_LIMIT);
      setText("[data-storage-note]", `Keeping the newest ${SCENARIO_LIMIT}. Removed: ${removed.map((item) => item.name).join(", ")}.`);
    }
    renderSavedScenarios();
    if (nameInput) nameInput.value = "";
  });
  root?.querySelectorAll<HTMLButtonElement>("[data-defense-toggle]").forEach((button) => button.addEventListener("click", () => {
    const answer = button.closest("[data-defense-card]")?.querySelector<HTMLElement>("[data-defense-answer]");
    if (!answer) return;
    answer.hidden = !answer.hidden;
    button.setAttribute("aria-expanded", String(!answer.hidden));
    button.textContent = answer.hidden ? "Reveal talking point" : "Hide talking point";
  }));

  savedScenarios = loadScenarios();
  renderSavedScenarios();
  const params = new URLSearchParams(location.search);
  const preset = params.get("preset");
  if (preset && labPresets[preset]) applyState(labPresets[preset], preset);
  else if (labKeys.some((key) => params.has(key))) applyState(parseLabParams(params));
  else update();
</script>

