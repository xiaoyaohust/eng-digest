---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/url";
---

<BaseLayout
  title="Architecture Decision Lab"
  description="Explore how scale, latency, consistency, retention, and geography change a distributed system design."
>
  <div class="lab-page" data-architecture-lab>
    <header class="lab-hero">
      <div class="wrap lab-hero-grid">
        <div>
          <span class="eyebrow">INTERACTIVE / TRADE-OFF ENGINE</span>
          <h1>Architecture<br />Decision Lab</h1>
          <p>
            Change the constraints. Watch the architecture move. The output is a starting
            hypothesis—not a substitute for workload-specific measurement.
          </p>
        </div>
        <div class="signal-panel" aria-hidden="true">
          <span>MODEL / V1</span>
          <div class="signal-line"><i></i><i></i><i></i><i></i><i></i></div>
          <strong>INPUT → PRESSURE → DECISION</strong>
        </div>
      </div>
    </header>

    <div class="wrap lab-workbench">
      <section class="control-panel" aria-labelledby="constraints-title">
        <div class="panel-head">
          <div><span class="eyebrow">01 / CONSTRAINTS</span><h2 id="constraints-title">Shape the workload</h2></div>
          <button type="button" class="reset-button" data-reset>Reset</button>
        </div>

        <div class="presets" aria-label="Architecture presets">
          <button type="button" data-preset="api">High-traffic API</button>
          <button type="button" data-preset="logs">Log platform</button>
          <button type="button" data-preset="ledger">Financial ledger</button>
          <button type="button" data-preset="feed">Global feed</button>
        </div>

        <div class="controls-grid">
          <label>
            <span>Peak requests / second</span>
            <strong data-qps-output>10,000</strong>
            <input type="range" min="100" max="1000000" step="100" value="10000" data-input="qps" />
            <small>100 → 1,000,000 QPS</small>
          </label>

          <label>
            <span>Average payload size</span>
            <strong data-size-output>2 KB</strong>
            <input type="range" min="1" max="1024" step="1" value="2" data-input="sizeKb" />
            <small>1 KB → 1 MB per event</small>
          </label>

          <label>
            <span>Target p99 latency</span>
            <select data-input="latency">
              <option value="20">20 ms</option>
              <option value="50" selected>50 ms</option>
              <option value="100">100 ms</option>
              <option value="250">250 ms</option>
              <option value="1000">1 second</option>
            </select>
          </label>

          <label>
            <span>Consistency requirement</span>
            <select data-input="consistency">
              <option value="eventual">Eventual</option>
              <option value="read-your-writes">Read your writes</option>
              <option value="strong" selected>Strong</option>
            </select>
          </label>

          <label>
            <span>Retention period</span>
            <strong data-retention-output>30 days</strong>
            <input type="range" min="1" max="365" step="1" value="30" data-input="retention" />
            <small>1 → 365 days</small>
          </label>

          <label>
            <span>Geographic footprint</span>
            <select data-input="regions">
              <option value="1" selected>Single region</option>
              <option value="2">Primary + failover</option>
              <option value="3">Active in 3+ regions</option>
            </select>
          </label>
        </div>
      </section>

      <!--
        No aria-live on this panel: it re-renders in full on every slider tick,
        so a live region here makes a screen reader read out four metrics, six
        decisions and two lists dozens of times during one drag. A short,
        debounced status line below carries the headline numbers instead.
      -->
      <section class="result-panel" aria-labelledby="recommendation-title">
        <div class="panel-head">
          <div><span class="eyebrow">02 / DECISIONS</span><h2 id="recommendation-title">Recommended starting point</h2></div>
          <button type="button" class="copy-button-lab" data-copy-summary>Copy design brief</button>
        </div>

        <p class="lab-live-status" data-lab-status aria-live="polite"></p>

        <div class="metric-grid">
          <!-- Placeholders match what recommend() computes for the default
               state, so the panel is still correct with JS disabled. -->
          <article><span>INGRESS</span><strong data-metric="ingress">19.5 MB/s</strong><small>uncompressed peak</small></article>
          <article><span>DAILY DATA</span><strong data-metric="daily">1.6 TB</strong><small>before compression</small></article>
          <article><span>RETENTION</span><strong data-metric="stored">48.3 TB</strong><small>raw logical volume</small></article>
          <article><span>PARTITIONS</span><strong data-metric="partitions">3</strong><small>starting stream width</small></article>
        </div>

        <div class="architecture-flow" aria-label="Recommended architecture flow">
          <div class="flow-node"><small>EDGE</small><strong data-node="edge">Load Balancer</strong></div>
          <span>→</span>
          <div class="flow-node"><small>COMPUTE</small><strong data-node="compute">Stateless Service</strong></div>
          <span>→</span>
          <div class="flow-node"><small>BUFFER</small><strong data-node="buffer">Durable Queue</strong></div>
          <span>→</span>
          <div class="flow-node"><small>STATE</small><strong data-node="state">Distributed SQL</strong></div>
        </div>

        <div class="decision-grid">
          <article>
            <span class="decision-code">D01 / DATA</span>
            <h3 data-decision="database">Distributed SQL / NewSQL</h3>
            <p data-reason="database"></p>
          </article>
          <article>
            <span class="decision-code">D02 / CACHE</span>
            <h3 data-decision="cache">Distributed cache</h3>
            <p data-reason="cache"></p>
          </article>
          <article>
            <span class="decision-code">D03 / STREAM</span>
            <h3 data-decision="stream">Kafka-compatible event log</h3>
            <p data-reason="stream"></p>
          </article>
          <article>
            <span class="decision-code">D04 / STORAGE</span>
            <h3 data-decision="storage">Object storage archive</h3>
            <p data-reason="storage"></p>
          </article>
          <article>
            <span class="decision-code">D05 / REPLICATION</span>
            <h3 data-decision="replication">Synchronous regional replicas</h3>
            <p data-reason="replication"></p>
          </article>
          <article>
            <span class="decision-code">D06 / READ PATH</span>
            <h3 data-decision="readPath">Cache-aside reads</h3>
            <p data-reason="readPath"></p>
          </article>
        </div>

        <div class="tradeoffs">
          <div>
            <span class="eyebrow">PRESSURE POINTS</span>
            <ul data-pressure-list></ul>
          </div>
          <div>
            <span class="eyebrow">EXPLICIT TRADE-OFFS</span>
            <ul data-tradeoff-list></ul>
          </div>
        </div>

        <div class="lab-next">
          <div><span class="eyebrow">NEXT STEP</span><h2>Defend the choices in an interview.</h2></div>
          <a href={withBase("/learning-paths/system-design-fundamentals/")}>Open the fundamentals path →</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    buildLabQuery,
    labDefaults,
    labPresets,
    parseLabParams,
    recommendArchitecture,
    sanitizeLabValue,
    type LabState,
  } from "@/lib/architectureLab";

  type LabControl = HTMLInputElement | HTMLSelectElement;
  const labKeys = Object.keys(labDefaults) as (keyof LabState)[];

  const root = document.querySelector<HTMLElement>("[data-architecture-lab]");
  const inputs: Partial<Record<keyof LabState, LabControl>> = Object.fromEntries(
    Array.from(root?.querySelectorAll<LabControl>("[data-input]") ?? []).map((input) => [input.dataset.input, input])
  );

  function formatNumber(value: number): string {
    return new Intl.NumberFormat("en-US", { maximumFractionDigits: 1 }).format(value);
  }

  function setText(selector: string, value: string): void {
    const element = root?.querySelector(selector);
    if (element) element.textContent = value;
  }

  function setList(selector: string, items: string[]): void {
    const list = root?.querySelector(selector);
    if (!list) return;
    list.replaceChildren(...items.map((item) => {
      const li = document.createElement("li");
      li.textContent = item;
      return li;
    }));
  }

  /** Read the controls back as a valid LabState.
   *
   * The DOM normally constrains these (a range clamps, a select only holds its
   * own options), but this is the one path that reaches recommendArchitecture
   * without passing through sanitizeLabValue — so anything unexpected, from a
   * restored form state to an extension rewriting a control, would otherwise
   * produce a confident recommendation from nonsense input. Falling back to
   * the default for that field keeps the panel honest. */
  function readState(): LabState {
    const state = { ...labDefaults };
    labKeys.forEach((key) => {
      const input = inputs[key];
      if (!input) return;
      const value = sanitizeLabValue(key, input.value);
      if (value !== null) (state[key] as LabState[typeof key]) = value;
    });
    return state;
  }

  function applyState(state: LabState): void {
    labKeys.forEach((key) => {
      const input = inputs[key];
      const safe = sanitizeLabValue(key, state[key]);
      if (safe !== null && input) input.value = String(safe);
    });
    update();
  }

  let urlTimer: ReturnType<typeof setTimeout> | undefined;
  let pendingAnnouncement = "";
  // The design brief lives here rather than on the DOM node, so it is typed
  // and cannot be clobbered by anything else touching the element.
  let designBrief = "";
  function announce(message: string): void {
    const status = root?.querySelector("[data-lab-status]");
    if (status) status.textContent = message;
  }

  function updateUrl(query: string): void {
    // Range inputs fire `input` continuously while dragging, and Safari throws
    // a SecurityError after roughly 100 history calls in 30 seconds — which
    // would kill the update loop part-way through a single slider drag. The
    // visible panel still updates on every tick; only the address bar waits.
    clearTimeout(urlTimer);
    urlTimer = setTimeout(() => {
      try {
        history.replaceState(null, "", `${location.pathname}?${query}`);
      } catch {
        /* History throttled or unavailable; the lab itself is unaffected. */
      }
      announce(pendingAnnouncement);
    }, 250);
  }

  function update(): void {
    const state = readState();
    const result = recommendArchitecture(state);
    setText("[data-qps-output]", formatNumber(state.qps));
    setText("[data-size-output]", state.sizeKb >= 1024 ? "1 MB" : `${formatNumber(state.sizeKb)} KB`);
    setText("[data-retention-output]", `${state.retention} days`);
    setText('[data-metric="ingress"]', `${formatNumber(result.ingressMb)} MB/s`);
    setText('[data-metric="daily"]', `${formatNumber(result.dailyTb)} TB`);
    setText('[data-metric="stored"]', `${formatNumber(result.storedTb)} TB`);
    setText('[data-metric="partitions"]', String(result.partitions));

    ([
      ["database", result.database, result.databaseReason],
      ["cache", result.cache, result.cacheReason],
      ["stream", result.stream, result.streamReason],
      ["storage", result.storage, result.storageReason],
      ["replication", result.replication, result.replicationReason],
      ["readPath", result.readPath, result.readPathReason],
    ] as const).forEach(([key, decision, reason]) => {
      setText(`[data-decision="${key}"]`, decision);
      setText(`[data-reason="${key}"]`, reason);
    });
    setText('[data-node="edge"]', state.regions > 1 ? "Geo Router" : "Load Balancer");
    setText('[data-node="compute"]', result.highScale ? "Autoscaled Services" : "Stateless Service");
    setText('[data-node="buffer"]', result.stream);
    setText('[data-node="state"]', result.database);
    setList("[data-pressure-list]", result.pressures);
    setList("[data-tradeoff-list]", result.tradeoffs);
    if (root) root.dataset.scale = result.highScale ? "high" : "standard";
    // Built here rather than read back from location.href: the address bar is
    // written on a debounce, so reading it would put a stale link in the brief.
    const query = buildLabQuery(state);
    const shareUrl = `${location.origin}${location.pathname}?${query}`;
    pendingAnnouncement = `${formatNumber(state.qps)} QPS, ${state.consistency} consistency, ${state.regions} region(s): ${result.database}, ${result.stream}, ${result.storage}. Ingress ${formatNumber(result.ingressMb)} megabytes per second, ${result.partitions} partitions.`;
    updateUrl(query);
    designBrief = [
      "Architecture Decision Lab — Design Brief",
      `Peak traffic: ${formatNumber(state.qps)} QPS`,
      `Payload: ${formatNumber(state.sizeKb)} KB`,
      `Target p99: ${state.latency} ms`,
      `Consistency: ${state.consistency}`,
      `Retention: ${state.retention} days`,
      `Regions: ${state.regions}`,
      "",
      `Ingress: ${formatNumber(result.ingressMb)} MB/s`,
      `Daily data: ${formatNumber(result.dailyTb)} TB`,
      `Starting partitions: ${result.partitions}`,
      `Database: ${result.database}`,
      `Cache: ${result.cache}`,
      `Stream: ${result.stream}`,
      `Storage: ${result.storage}`,
      `Replication: ${result.replication}`,
      "",
      `Explore: ${shareUrl}`,
    ].join("\n");
  }

  root?.querySelectorAll<LabControl>("[data-input]").forEach((input) => input.addEventListener("input", update));
  root?.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((button) => button.addEventListener("click", () => {
    const preset = labPresets[button.dataset.preset ?? ""];
    if (preset) applyState(preset);
  }));
  root?.querySelector("[data-reset]")?.addEventListener("click", () => applyState(labDefaults));
  root?.querySelector<HTMLButtonElement>("[data-copy-summary]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(designBrief);
      button.textContent = "Copied";
      setTimeout(() => { button.textContent = "Copy design brief"; }, 1600);
    } catch { button.textContent = "Copy unavailable"; }
  });

  const params = new URLSearchParams(location.search);
  const preset = params.get("preset");
  if (preset && labPresets[preset]) {
    applyState(labPresets[preset]);
  } else if (labKeys.some((key) => params.has(key))) {
    applyState(parseLabParams(params));
  } else {
    update();
  }
</script>

<style>
  .lab-hero { position: relative; border-bottom: 1px solid #243347; background: #0a121e; color: #edf5f8; overflow: hidden; }
  .lab-hero::before { position: absolute; inset: 0; background-image: linear-gradient(rgba(93, 137, 175, 0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(93, 137, 175, 0.08) 1px, transparent 1px); background-size: 36px 36px; content: ""; }
  .lab-hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 64px; align-items: center; padding: 64px 0; }
  .lab-hero h1 { margin: 10px 0 18px; color: #f4f8fb; font-family: var(--font-display); font-size: clamp(3rem, 7vw, 6.2rem); letter-spacing: -0.065em; line-height: 0.88; }
  .lab-hero p { max-width: 680px; margin: 0; color: #9eb0c4; font-size: 1.06rem; }
  .signal-panel { padding: 26px; border: 1px solid #29425c; background: rgba(11, 24, 39, 0.82); font-family: var(--font-mono); }
  .signal-panel > span { color: #62efdb; font-size: 0.62rem; letter-spacing: 0.08em; }
  .signal-line { display: flex; align-items: flex-end; gap: 8px; height: 110px; padding: 18px 0; }
  .signal-line i { width: 18%; background: #18334a; }
  .signal-line i:nth-child(1) { height: 28%; }
  .signal-line i:nth-child(2) { height: 54%; }
  .signal-line i:nth-child(3) { height: 42%; background: #f2a93b; }
  .signal-line i:nth-child(4) { height: 80%; background: #19c6b3; }
  .signal-line i:nth-child(5) { height: 66%; }
  .signal-panel strong { color: #c6d3df; font-size: 0.67rem; }
  .lab-workbench { display: grid; grid-template-columns: minmax(300px, 0.72fr) minmax(0, 1.45fr); gap: 24px; align-items: start; padding: 42px 0 80px; }
  .control-panel, .result-panel { border: 1px solid var(--color-border); background: color-mix(in srgb, var(--color-bg-raised) 94%, transparent); box-shadow: var(--shadow-card); }
  .control-panel { position: sticky; top: 92px; }
  .panel-head { display: flex; justify-content: space-between; gap: 20px; align-items: flex-start; padding: 20px 22px; border-bottom: 1px solid var(--color-border); }
  /* Visually hidden: this exists only to give screen readers a short, debounced
     summary in place of a live region over the whole re-rendering panel. */
  .lab-live-status { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
  .panel-head h2 { margin: 5px 0 0; font-family: var(--font-display); font-size: 1.55rem; letter-spacing: -0.035em; }
  .reset-button, .copy-button-lab { padding: 7px 9px; border: 1px solid var(--color-border-strong); border-radius: 4px; background: var(--color-bg-inset); color: var(--color-text-muted); cursor: pointer; font-family: var(--font-mono); font-size: 0.62rem; }
  .presets { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; border-bottom: 1px solid var(--color-border); background: var(--color-border); }
  .presets button { padding: 10px; border: 0; background: var(--color-bg-raised); color: var(--color-text-muted); cursor: pointer; font-family: var(--font-mono); font-size: 0.63rem; }
  .presets button:hover { background: var(--color-bg-inset); color: var(--color-accent); }
  .controls-grid { display: grid; gap: 1px; background: var(--color-border); }
  .controls-grid label { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 9px 14px; padding: 17px 20px; background: var(--color-bg-raised); }
  .controls-grid label > span { font-size: 0.84rem; font-weight: 700; }
  .controls-grid label > strong { color: var(--color-accent); font-family: var(--font-mono); font-size: 0.72rem; }
  .controls-grid input, .controls-grid select { grid-column: 1 / -1; width: 100%; accent-color: var(--color-accent); }
  .controls-grid select { padding: 8px 10px; border: 1px solid var(--color-border); border-radius: 5px; background: var(--color-bg-inset); color: var(--color-text); }
  .controls-grid small { grid-column: 1 / -1; color: var(--color-text-muted); font-family: var(--font-mono); font-size: 0.58rem; }
  .metric-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--color-border); border-bottom: 1px solid var(--color-border); }
  .metric-grid article { display: flex; min-width: 0; flex-direction: column; gap: 6px; padding: 18px; background: var(--color-bg-raised); }
  .metric-grid span, .metric-grid small { color: var(--color-text-muted); font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.05em; }
  .metric-grid strong { font-family: var(--font-display); font-size: 1.35rem; line-height: 1; }
  .architecture-flow { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr) auto); align-items: center; gap: 8px; padding: 26px 22px; border-bottom: 1px solid var(--color-border); background: var(--color-bg-inset); overflow-x: auto; }
  .architecture-flow > span { color: var(--color-accent); font-weight: 800; }
  .flow-node { min-width: 120px; padding: 13px; border: 1px solid var(--color-border-strong); background: var(--color-bg-raised); }
  .flow-node small { display: block; margin-bottom: 6px; color: var(--color-accent); font-family: var(--font-mono); font-size: 0.55rem; }
  .flow-node strong { display: block; font-size: 0.77rem; line-height: 1.35; }
  .decision-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--color-border); }
  .decision-grid article { min-height: 188px; padding: 22px; background: var(--color-bg-raised); }
  .decision-code { color: var(--color-accent); font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.08em; }
  .decision-grid h3 { margin: 24px 0 9px; font-family: var(--font-display); font-size: 1.25rem; letter-spacing: -0.025em; line-height: 1.15; }
  .decision-grid p { margin: 0; color: var(--color-text-muted); font-size: 0.84rem; }
  .tradeoffs { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; padding-top: 1px; background: var(--color-border); }
  .tradeoffs > div { padding: 24px; background: var(--color-bg-inset); }
  .tradeoffs ul { margin: 14px 0 0; padding-left: 18px; color: var(--color-text-muted); font-size: 0.84rem; }
  .tradeoffs li + li { margin-top: 9px; }
  .lab-next { display: flex; justify-content: space-between; gap: 24px; align-items: center; padding: 28px 24px; border-top: 1px solid var(--color-border); }
  .lab-next h2 { margin: 5px 0 0; font-family: var(--font-display); font-size: 1.45rem; }
  .lab-next a { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 750; }
  @media (max-width: 1040px) {
    .lab-workbench { grid-template-columns: 1fr; }
    .control-panel { position: static; }
  }
  @media (max-width: 760px) {
    .lab-hero-grid { grid-template-columns: 1fr; gap: 32px; padding: 48px 0; }
    .signal-panel { display: none; }
    .metric-grid, .decision-grid, .tradeoffs { grid-template-columns: 1fr 1fr; }
    .lab-next { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 520px) {
    .metric-grid, .decision-grid, .tradeoffs { grid-template-columns: 1fr; }
    .architecture-flow { grid-template-columns: 1fr; }
    .architecture-flow > span { transform: rotate(90deg); justify-self: center; }
  }
</style>
